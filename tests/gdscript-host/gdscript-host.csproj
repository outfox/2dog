<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <TwoDogAutoImport>false</TwoDogAutoImport>
        <TwoDogExportPack>false</TwoDogExportPack>
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
        <DefaultItemExcludes>$(DefaultItemExcludes);fixtures/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="2dog.engine" Version="$(TwoDogVersion)" />
        <PackageReference Include="2dog.godotsharp.editor" Version="$(TwoDogVersion)" />
        <ProjectReference Include="fixtures/mixed/GdScriptHostFixture.csproj" />
        <AssemblyMetadata Include="ProbeSource" Value="$(MSBuildProjectDirectory)" />
        <AssemblyMetadata Include="GdUnitSource" Value="$(MSBuildProjectDirectory)/../../gdunit" />
    </ItemGroup>
    <Target Name="WriteProbeImportPaths" AfterTargets="Build" DependsOnTargets="TwoDogResolveContentCapability">
        <Error Condition="'$(TwoDogCanUseImportHelper)' != 'true'" Text="The GDScript host probe requires packed editor natives and 2dog.tools for resource import." />
        <WriteLinesToFile File="$(TargetDir)import.paths"
                          Lines="$(TwoDogImportHelperPath);$(TwoDogEditorLibGodotPath);$(_TwoDogApiDirArg);$(_TwoDogToolsDirArg)"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>
</Project>
