<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <EnableNUnitRunner>true</EnableNUnitRunner>
        <GodotProjectDir>../game</GodotProjectDir>
        <TwoDogExportPack>false</TwoDogExportPack>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="2dog.engine$(TwoDogPackageSuffix)" Version="$(TwoDogVersion)" />
        <PackageReference Include="2dog.nunit" Version="$(TwoDogVersion)" />
        <PackageReference Include="NUnit" Version="4.*" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.*" />
    </ItemGroup>
</Project>
