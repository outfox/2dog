<Project Sdk="Godot.NET.Sdk/4.8.0-beta">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<GodotProjectDir>$(MSBuildProjectDirectory)</GodotProjectDir>
    <TwoDogWebPrecompress>false</TwoDogWebPrecompress>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="2dog.engine" Version="$(TwoDogVersion)" />
    <PackageReference Include="2dog.browser-wasm" Version="$(NativesVersion)" />
    <Compile Include="../webgpu-smoke/LightingScene.cs" Link="LightingScene.cs" />
    <Compile Include="../webgpu-smoke/TextureSwizzleSmoke.cs" Link="TextureSwizzleSmoke.cs" />
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>
</Project>
