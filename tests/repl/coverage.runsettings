<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Measure the entire packaged host, including terminal I/O and lifetime. -->
          <Include>[twodog.repl]*</Include>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <!-- Packed on Linux, measured on Windows: the PDB source paths do not exist here.
               Keep the entire assembly eligible for instrumentation regardless of source paths. -->
          <ExcludeAssembliesWithoutSources>None</ExcludeAssembliesWithoutSources>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
