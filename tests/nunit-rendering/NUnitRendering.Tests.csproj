<Project Sdk="Microsoft.NET.Sdk">
    <!-- Separate from the headless suite because these tests require a display. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GodotProjectDir>../windowed-fixture/project</GodotProjectDir>
        <TwoDogVariant Condition="'$(Configuration)' == 'Debug'">debug</TwoDogVariant>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="2dog.nunit" Version="$(TwoDogVersion)" />
        <PackageReference Include="NUnit" Version="4.*" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.*" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    </ItemGroup>
    <!-- VSTest launches testhost.exe in this output directory on Windows. Stage the
         CI loader beside it: Windows searches System32 before PATH, so PATH alone
         would silently select a preinstalled, potentially older Vulkan loader. -->
    <ItemGroup Condition="'$(TWODOG_TEST_VULKAN_LOADER)' != '' and $([MSBuild]::IsOSPlatform('Windows'))">
        <None Include="$(TWODOG_TEST_VULKAN_LOADER)" Link="vulkan-1.dll" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
