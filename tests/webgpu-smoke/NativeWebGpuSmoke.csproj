<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TwoDogAutoImport>false</TwoDogAutoImport>
    <TwoDogExportPack>false</TwoDogExportPack>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="2dog.engine$(TwoDogPackageSuffix)" Version="$(TwoDogVersion)" />
    <None Update="project.godot;main.tscn" CopyToOutputDirectory="PreserveNewest" />
    <!-- CI smoke jobs check out without the godot submodule; only the MSAA smoke needs this script. -->
    <None Include="../../godot/drivers/webgpu/tests/native_smoke/msaa.gd" Link="msaa.gd" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../godot/drivers/webgpu/tests/native_smoke/msaa.gd')" />
    <None Update="global_script_class_cache.cfg" TargetPath=".godot/global_script_class_cache.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
