<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>twodog.Hosting</RootNamespace>
        <AssemblyName>twodog.hosting</AssemblyName>
        <!-- Packaging (2dog.hosting) is future work; in-repo consumers use project references. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- References NOTHING Godot: instance ALCs fall through to the default-ALC copy, giving the contract types
         one identity across every instance. -->

    <ItemGroup>
        <!-- Unit tests for internals (ExceptionSanitizer). -->
        <InternalsVisibleTo Include="twodog.tests" />
    </ItemGroup>

</Project>
