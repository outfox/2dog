<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- A 'twodog.Avalonia' namespace would collide with the root 'Avalonia' namespace in
             every file; public types share the engine's 'twodog' namespace instead. -->
        <RootNamespace>twodog</RootNamespace>
    </PropertyGroup>

    <!-- NuGet Package Metadata -->
    <PropertyGroup>
        <PackageId>2dog.avalonia</PackageId>
        <Version>$(TwoDogVersion)</Version>
        <Description>Embed a Godot viewport inside an Avalonia application with 2dog. GodotControl composites the engine's output through Avalonia's compositor, so ordinary Avalonia controls render on top of the running game.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <IsPackable>true</IsPackable>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageTags>godot;2dog;avalonia;game-engine</PackageTags>
    </PropertyGroup>

    <!-- Plain References do not flow across ProjectReference, so the engine's is repeated. Not packed: consumers
         get GodotSharp.dll from 2dog.engine's lib/net10.0/. -->
    <ItemGroup>
        <Reference Include="GodotSharp">
            <HintPath>$([MSBuild]::EnsureTrailingSlash('$(TwoDogGodotSharpApiDir)'))Release/GodotSharp.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- The ProjectReference packs as a same-version 2dog.engine dependency. Only Avalonia core is referenced;
         backend selection (Avalonia.Desktop) belongs to the application. -->
    <ItemGroup>
        <ProjectReference Include="..\twodog.engine\twodog.engine.csproj"/>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)"/>
        <!-- Windows zero-copy path (D3D11 shared textures); same bindings Avalonia's own
             GpuInterop sample uses. Managed-only, safe to reference cross-platform. -->
        <PackageReference Include="Silk.NET.Direct3D11" Version="2.22.0"/>
        <PackageReference Include="Silk.NET.DXGI" Version="2.22.0"/>
    </ItemGroup>

    <!-- Package icon and readme -->
    <ItemGroup>
        <None Include="../nuget/icon.png" Pack="true" PackagePath="icon.png" Visible="false"/>
        <None Include="README.md" Pack="true" PackagePath="README.md"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="twodog.tests"/>
    </ItemGroup>
</Project>
