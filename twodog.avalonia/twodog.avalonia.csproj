<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- A 'twodog.Avalonia' namespace would collide with the root 'Avalonia' namespace in
             every file; public types share the engine's 'twodog' namespace instead. -->
        <RootNamespace>twodog</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- NuGet Package Metadata -->
    <PropertyGroup>
        <PackageId>2dog.avalonia</PackageId>
        <Version>$(TwoDogVersion)</Version>
        <!-- One package works with either engine precision; the host selects its engine explicitly. -->
        <TwoDogPrecisionNeutral>true</TwoDogPrecisionNeutral>
        <Description>Embed a Godot viewport inside an Avalonia application with 2dog. GodotControl composites the engine's output through Avalonia's compositor, so ordinary Avalonia controls render on top of the running game.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <IsPackable>true</IsPackable>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageTags>godot;2dog;avalonia;game-engine</PackageTags>
    </PropertyGroup>

    <!-- Managed bindings flow transitively from the engine ProjectReference. -->

    <!-- The engine is a private build dependency. The host selects 2dog.engine or 2dog.engine.double.
         Only Avalonia core is referenced; backend selection belongs to the application. -->
    <ItemGroup>
        <ProjectReference Include="..\twodog.engine\twodog.engine.csproj" PrivateAssets="all"/>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)"/>
    </ItemGroup>

    <!-- Package icon and readme -->
    <ItemGroup>
        <None Include="../nuget/icon.png" Pack="true" PackagePath="icon.png" Visible="false"/>
        <None Include="README.md" Pack="true" PackagePath="README.md"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="twodog.tests"/>
        <InternalsVisibleTo Include="WindowedFixture.Tests"/>
    </ItemGroup>
</Project>
