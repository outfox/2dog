<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- WinExe hides the console on Windows (plain Exe elsewhere); switch to Exe
             to see the engine's stdout diagnostics. -->
        <OutputType>WinExe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- The assembly keeps the folder name, but 'Company.Product1.avalonia'
             would differ from the other hosts for types shared with them. -->
        <RootNamespace>Company.Product1</RootNamespace>
        <!-- comctl32 v6 + long paths for Godot's Windows display server -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Publish bundles the .NET runtime so the output runs without a .NET install;
             opt out with -p:PublishSelfContained=false -->
        <PublishSelfContained>true</PublishSelfContained>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="2dog.avalonia" Version="TWODOG_PKG_VERSION"/>
        <PackageReference Include="Avalonia.Desktop" Version="AVALONIA_PKG_VERSION"/>
        <!-- Native Wayland backend (experimental, not part of UsePlatformDetect);
             enabled via UseWaylandWithFallback so X11 remains the fallback. -->
        <PackageReference Include="Avalonia.Wayland" Version="AVALONIA_PKG_VERSION"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="AVALONIA_PKG_VERSION"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../TPLRAWNAME.csproj"/>
    </ItemGroup>

    <!-- Godot project = the parent directory (solution root); nested hosts are hidden from the Godot editor by
         their .gdignore -->
    <PropertyGroup>
        <GodotProjectDir>..</GodotProjectDir>
        <TwoDogVariant Condition="'$(Configuration)' == 'Debug'">debug</TwoDogVariant>
        <TwoDogVariant Condition="'$(Configuration)' == 'Editor'">editor</TwoDogVariant>
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
    </PropertyGroup>
</Project>
