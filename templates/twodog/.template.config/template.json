{
  "$schema": "http://json.schemastore.org/template",
  "author": "outfox",
  "classifications": [
    "Game",
    "Godot",
    "2dog"
  ],
  "identity": "outfox.2dog.Template",
  "name": "2dog Application",
  "shortName": "2dog",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Company.Product1",
  "guids": [
    "B1A2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D",
    "A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D",
    "D5E6F7A8-B9C0-4D1E-2F3A-4B5C6D7E8F9A",
    "C7D8E9F0-A1B2-4C3D-8E9F-0A1B2C3D4E5F"
  ],
  "preferNameDirectory": true,
  "symbols": {
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    },
    "rawName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "TPLRAWNAME"
    },
    "twodogVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-tpl",
      "replaces": "TWODOG_PKG_VERSION",
      "description": "Version of 2dog packages to reference."
    },
    "nativesVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-ntpl",
      "replaces": "NATIVES_PKG_VERSION",
      "description": "Version of native platform packages to reference."
    },
    "godotVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "4.7.0",
      "replaces": "GODOT_SDK_VERSION",
      "description": "Version of Godot.NET.Sdk and GodotSharp to reference."
    },
    "avaloniaVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-avtpl",
      "replaces": "AVALONIA_PKG_VERSION",
      "description": "Version of Avalonia packages to reference."
    },
    "winAppSdkVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-watpl",
      "replaces": "WINAPPSDK_PKG_VERSION",
      "description": "Version of the Microsoft.WindowsAppSDK package to reference."
    },
    "aspNetCoreVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-aspntpl",
      "replaces": "ASPNETCORE_PKG_VERSION",
      "description": "Version of the ASP.NET Core (Blazor) packages to reference."
    },
    "qtBridgeVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-qtbtpl",
      "replaces": "QTBRIDGE_PKG_VERSION",
      "description": "Version of the Qt Bridge for C# packages (QtGroup.Qt.Bridge.CSharp.<rid>) to reference."
    },
    "xunit": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a test project with xUnit (v3) and the 2dog.xunit collection fixtures. Omitted by default; pass '--xunit true' to include.",
      "defaultValue": "false"
    },
    "repl": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include an interactive C# REPL host inside the running Godot process. Omitted by default; pass '--repl true' to include.",
      "defaultValue": "false"
    },
    "gdunit": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a GdUnit GDScript test host using Microsoft.Testing.Platform (opt-in).",
      "defaultValue": "false"
    },
    "double-precision": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Use matching double precision bindings and natives throughout the project.",
      "defaultValue": "false"
    },
    "web-threads": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Enable experimental web multithreading (requires COOP/COEP headers).",
      "defaultValue": "false",
      "replaces": "TWODOG_WEB_THREADS"
    },
    "precisionSuffix": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "cases": [
          {
            "condition": "double-precision",
            "value": ".double"
          },
          {
            "condition": "true",
            "value": ""
          }
        ]
      },
      "replaces": "TWODOG_PRECISION_SUFFIX"
    },
    "precision": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "cases": [
          {
            "condition": "double-precision",
            "value": "double"
          },
          {
            "condition": "true",
            "value": "single"
          }
        ]
      },
      "replaces": "TWODOG_PRECISION"
    },
    "nunit": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include an NUnit test project using 2dog.nunit. Omitted by default; pass '--nunit true' to include.",
      "defaultValue": "false"
    },
    "web": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a browser (WebAssembly) host project. Requires a .NET 10+ SDK with the wasm-tools workload to build. Included by default; pass '--web false' to omit.",
      "defaultValue": "true"
    },
    "webxr": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a browser (WebAssembly) host project preconfigured for WebXR: its page ships the WebXR Layers polyfill Godot needs on browsers without native Layers support. Requires a .NET 10 SDK with the wasm-tools workload to build, like the web host. Omitted by default; pass '--webxr true' to include.",
      "defaultValue": "false"
    },
    "winforms": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a WinForms host project that embeds the game window inside a form (Windows-only at runtime). Omitted by default; pass '--winforms true' to include.",
      "defaultValue": "false"
    },
    "winui": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a WinUI 3 host project that embeds the game window inside a Windows App SDK window (Windows-only, builds only on Windows). Omitted by default; pass '--winui true' to include.",
      "defaultValue": "false"
    },
    "avalonia": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include an Avalonia host project that composites the game inside a cross-platform GUI window (Avalonia controls render on top of the game). Omitted by default; pass '--avalonia true' to include.",
      "defaultValue": "false"
    },
    "qt": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a Qt Quick (QML) host built on Qt Bridge for C#: 2dog.qt's GodotView shows the game inside the QML scene, so QML items render on top of it. Building needs CMake, Ninja and a C++ toolchain; Qt is bundled on win-x64, elsewhere set QtDir to a Qt 6 install. Omitted by default; pass '--qt true' to include.",
      "defaultValue": "false"
    },
    "blazor": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a Blazor Web App host: an ASP.NET Core server plus a Blazor WebAssembly client whose page embeds the game through 2dog.blazor's GodotView. Requires a .NET 10 SDK with the wasm-tools workload to build, like the web host. Omitted by default; pass '--blazor true' to include.",
      "defaultValue": "false"
    },
    "android": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include an experimental Android host whose publish produces an APK. Requires the android workload to build. Omitted by default; pass '--android true' to include.",
      "defaultValue": "false"
    },
    "androidName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "androidPackage",
      "replaces": "tplandroidname"
    },
    "maui": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a MAUI host with an embeddable GPU Godot view for Windows and Android. Requires MAUI workloads. Omitted by default; pass --maui true to include.",
      "defaultValue": "false"
    },
    "mauiVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-mauitpl",
      "replaces": "MAUI_PKG_VERSION",
      "description": "Version of Microsoft.Maui.Controls to reference."
    }
  },
  "forms": {
    "androidLower": {
      "identifier": "lowerCase"
    },
    "androidCharacters": {
      "identifier": "replace",
      "pattern": "[^a-z0-9_.]",
      "replacement": "_"
    },
    "androidDots": {
      "identifier": "replace",
      "pattern": "\\.{2,}",
      "replacement": "."
    },
    "androidEdges": {
      "identifier": "replace",
      "pattern": "^\\.|\\.$",
      "replacement": ""
    },
    "androidSegments": {
      "identifier": "replace",
      "pattern": "(^|\\.)([^a-z.])",
      "replacement": "$1app$2"
    },
    "androidPackage": {
      "identifier": "chain",
      "steps": [
        "androidLower",
        "androidCharacters",
        "androidDots",
        "androidEdges",
        "androidSegments"
      ]
    }
  },
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "#if"
            ],
            "else": [
              "#else"
            ],
            "elseif": [
              "#elseif"
            ],
            "endif": [
              "#endif"
            ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!xunit)",
          "exclude": [
            "Company.Product1.xunit/**/*"
          ]
        },
        {
          "condition": "(!repl)",
          "exclude": [
            "Company.Product1.repl/**/*"
          ]
        },
        {
          "condition": "(!gdunit)",
          "exclude": [
            "Company.Product1.gdunit/**/*"
          ]
        },
        {
          "condition": "(!nunit)",
          "exclude": [
            "Company.Product1.nunit/**/*"
          ]
        },
        {
          "condition": "(!web)",
          "exclude": [
            "Company.Product1.web/**/*"
          ]
        },
        {
          "condition": "(!webxr)",
          "exclude": [
            "Company.Product1.webxr/**/*"
          ]
        },
        {
          "condition": "(!web && !webxr && !blazor && !maui && !xunit && !nunit && !gdunit)",
          "exclude": [
            "global.json"
          ]
        },
        {
          "condition": "(!winforms)",
          "exclude": [
            "Company.Product1.winforms/**/*"
          ]
        },
        {
          "condition": "(!winui)",
          "exclude": [
            "Company.Product1.winui/**/*"
          ]
        },
        {
          "condition": "(!avalonia)",
          "exclude": [
            "Company.Product1.avalonia/**/*"
          ]
        },
        {
          "condition": "(!qt)",
          "exclude": [
            "Company.Product1.qt/**/*"
          ]
        },
        {
          "condition": "(!blazor)",
          "exclude": [
            "Company.Product1.blazor/**/*"
          ]
        },
        {
          "condition": "(!android)",
          "exclude": [
            "Company.Product1.android/**/*"
          ]
        },
        {
          "copyOnly": [
            "Company.Product1.web/wwwroot/favicon*",
            "Company.Product1.webxr/wwwroot/favicon*",
            "Company.Product1.webxr/wwwroot/*.min.js",
            "Company.Product1.blazor/wwwroot/favicon*",
            "Company.Product1.android/Resources/**/*.png"
          ]
        },
        {
          "condition": "(!maui)",
          "exclude": [
            "Company.Product1.maui/**/*"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "Company.Product1.slnx"
    },
    {
      "path": "Company.Product1.csproj"
    },
    {
      "path": "Company.Product1.2dog/Company.Product1.2dog.csproj"
    },
    {
      "condition": "(xunit)",
      "path": "Company.Product1.xunit/Company.Product1.xunit.csproj"
    },
    {
      "condition": "(repl)",
      "path": "Company.Product1.repl/Company.Product1.repl.csproj"
    },
    {
      "condition": "(gdunit)",
      "path": "Company.Product1.gdunit/Company.Product1.gdunit.csproj"
    },
    {
      "condition": "(nunit)",
      "path": "Company.Product1.nunit/Company.Product1.nunit.csproj"
    },
    {
      "condition": "(web)",
      "path": "Company.Product1.web/Company.Product1.web.csproj"
    },
    {
      "condition": "(webxr)",
      "path": "Company.Product1.webxr/Company.Product1.webxr.csproj"
    },
    {
      "condition": "(winforms)",
      "path": "Company.Product1.winforms/Company.Product1.winforms.csproj"
    },
    {
      "condition": "(winui)",
      "path": "Company.Product1.winui/Company.Product1.winui.csproj"
    },
    {
      "condition": "(avalonia)",
      "path": "Company.Product1.avalonia/Company.Product1.avalonia.csproj"
    },
    {
      "condition": "(qt)",
      "path": "Company.Product1.qt/Company.Product1.qt.csproj"
    },
    {
      "condition": "(blazor)",
      "path": "Company.Product1.blazor/Company.Product1.blazor.csproj"
    },
    {
      "condition": "(blazor)",
      "path": "Company.Product1.blazor/Client/Company.Product1.blazor.Client.csproj"
    },
    {
      "condition": "(maui)",
      "path": "Company.Product1.maui/Company.Product1.maui.csproj"
    }
  ],
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
