{
  "$schema": "http://json.schemastore.org/template",
  "author": "outfox",
  "classifications": ["Game", "Godot", "2dog"],
  "identity": "outfox.2dog.Template",
  "name": "2dog Application",
  "shortName": "2dog",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Company.Product1",
  "guids": [
    "B1A2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D",
    "A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D",
    "D5E6F7A8-B9C0-4D1E-2F3A-4B5C6D7E8F9A",
    "C7D8E9F0-A1B2-4C3D-8E9F-0A1B2C3D4E5F"
  ],
  "preferNameDirectory": true,
  "symbols": {
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    },
    "rawName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "TPLRAWNAME"
    },
    "twodogVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-tpl",
      "replaces": "TWODOG_PKG_VERSION",
      "description": "Version of 2dog packages to reference."
    },
    "nativesVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-ntpl",
      "replaces": "NATIVES_PKG_VERSION",
      "description": "Version of native platform packages to reference."
    },
    "godotVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "4.7.0",
      "replaces": "GODOT_SDK_VERSION",
      "description": "Version of Godot.NET.Sdk and GodotSharp to reference."
    },
    "avaloniaVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.0-avtpl",
      "replaces": "AVALONIA_PKG_VERSION",
      "description": "Version of Avalonia packages to reference."
    },
    "tests": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a test project with xUnit (v3) and the 2dog.xunit collection fixtures. Included by default; pass '--tests false' to omit.",
      "defaultValue": "true"
    },
    "web": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a browser (WebAssembly) host project. Requires a .NET 10+ SDK with the wasm-tools workload to build. Included by default; pass '--web false' to omit.",
      "defaultValue": "true"
    },
    "webxr": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a browser (WebAssembly) host project preconfigured for WebXR: its page ships the WebXR Layers polyfill Godot needs on browsers without native Layers support. Requires a .NET 10 SDK with the wasm-tools workload to build, like the web host. Omitted by default; pass '--webxr true' to include.",
      "defaultValue": "false"
    },
    "winforms": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include a WinForms host project that embeds the game window inside a form (Windows-only at runtime). Omitted by default; pass '--winforms true' to include.",
      "defaultValue": "false"
    },
    "avalonia": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include an Avalonia host project that composites the game inside a cross-platform GUI window (Avalonia controls render on top of the game). Omitted by default; pass '--avalonia true' to include.",
      "defaultValue": "false"
    }
  },
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["#if"],
            "else": ["#else"],
            "elseif": ["#elseif"],
            "endif": ["#endif"],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!tests)",
          "exclude": [
            "Company.Product1.tests/**/*"
          ]
        },
        {
          "condition": "(!web)",
          "exclude": [
            "Company.Product1.web/**/*"
          ]
        },
        {
          "condition": "(!webxr)",
          "exclude": [
            "Company.Product1.webxr/**/*"
          ]
        },
        {
          "condition": "(!web && !webxr)",
          "exclude": [
            "global.json"
          ]
        },
        {
          "condition": "(!winforms)",
          "exclude": [
            "Company.Product1.winforms/**/*"
          ]
        },
        {
          "condition": "(!avalonia)",
          "exclude": [
            "Company.Product1.avalonia/**/*"
          ]
        },
        {
          "copyOnly": [
            "Company.Product1.web/TwoDogWebBoot.cs",
            "Company.Product1.web/wwwroot/favicon*",
            "Company.Product1.webxr/TwoDogWebBoot.cs",
            "Company.Product1.webxr/wwwroot/favicon*",
            "Company.Product1.webxr/wwwroot/*.min.js"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "Company.Product1.slnx"
    },
    {
      "path": "Company.Product1.csproj"
    },
    {
      "path": "Company.Product1.2dog/Company.Product1.2dog.csproj"
    },
    {
      "condition": "(tests)",
      "path": "Company.Product1.tests/Company.Product1.tests.csproj"
    },
    {
      "condition": "(web)",
      "path": "Company.Product1.web/Company.Product1.web.csproj"
    },
    {
      "condition": "(webxr)",
      "path": "Company.Product1.webxr/Company.Product1.webxr.csproj"
    },
    {
      "condition": "(winforms)",
      "path": "Company.Product1.winforms/Company.Product1.winforms.csproj"
    },
    {
      "condition": "(avalonia)",
      "path": "Company.Product1.avalonia/Company.Product1.avalonia.csproj"
    }
  ],
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
