<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- WinExe hides the console on Windows (plain Exe elsewhere); switch to Exe
             to see the engine's stdout diagnostics. -->
        <OutputType>WinExe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- The assembly keeps the folder name, but 'TPLRAWNAME.qt'
             would differ from the other hosts for types shared with them. -->
        <RootNamespace>Company.Product1</RootNamespace>
        <!-- comctl32 v6 + long paths for Godot's Windows display server -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <!-- Qt Bridge for C# ships one package per RID (win-x64, win-arm64, linux-x64, osx-arm64). Only win-x64 bundles
         Qt; elsewhere pass a Qt 6 install, e.g. dotnet run -p:QtDir=/usr/lib/qt6 or export QtDir. -->
    <PropertyGroup>
        <QtBridgeRid Condition="'$(QtBridgeRid)' == ''">$(RuntimeIdentifier)</QtBridgeRid>
        <QtBridgeRid Condition="'$(QtBridgeRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win</QtBridgeRid>
        <QtBridgeRid Condition="'$(QtBridgeRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux</QtBridgeRid>
        <QtBridgeRid Condition="'$(QtBridgeRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx</QtBridgeRid>
        <QtBridgeRid Condition="!$(QtBridgeRid.Contains('-'))">$(QtBridgeRid)-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</QtBridgeRid>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="2dog.engineTWODOG_PRECISION_SUFFIX" Version="$(TwoDogVersion)" />
        <PackageReference Include="2dog.qt" Version="$(TwoDogVersion)"/>
        <PackageReference Include="QtGroup.Qt.Bridge.CSharp.$(QtBridgeRid)" Version="$(TwoDogQtBridgeVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../TPLRAWNAME.csproj"/>
    </ItemGroup>

    <!-- Godot project = the parent directory (solution root); nested hosts are hidden from the Godot editor by
         their .gdignore -->
    <PropertyGroup>
        <GodotProjectDir>..</GodotProjectDir>
        <TwoDogVariant Condition="'$(Configuration)' == 'Debug'">debug</TwoDogVariant>
        <TwoDogVariant Condition="'$(Configuration)' == 'Editor'">editor</TwoDogVariant>
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
    </PropertyGroup>
</Project>
