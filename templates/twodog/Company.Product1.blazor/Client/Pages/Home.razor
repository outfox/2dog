@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>TPLRAWNAME</PageTitle>

<div class="layout">
    <aside class="panel">
        <header class="panel-header">
            <div>
                <h1>TPLRAWNAME</h1>
                <p class="subtitle">Blazor UI beside Godot</p>
            </div>
            <p class="status" data-state="@_state">@_status</p>
        </header>

        <dl>
            <dt>Scene</dt>
            <dd>@_scene</dd>
            <dt>FPS</dt>
            <dd>@_fps</dd>
            <dt>Renderer</dt>
            <dd>@_renderer</dd>
            <dt>Driver</dt>
            <dd>@_driver</dd>
        </dl>

        <div class="actions">
            <button @onclick="() => _view!.StartAsync()" disabled="@(_view is null || _view.IsRunning)">Start engine</button>
            <button @onclick="() => _view?.Quit()" disabled="@(_view?.IsRunning != true)">Quit engine</button>
        </div>
    </aside>

    <main class="viewport">
        <GodotView @ref="_view" Project="TPLRAWNAME" PluginsInitializer="TwoDogWebBoot.PluginsInitializer()"
                   OnFrame="OnFrame" Started="OnStarted" Exited="OnExited" Failed="OnFailed"
                   style="width: 100%; height: 100%;" />
    </main>
</div>

@code {
    private GodotView? _view;
    private string _status = "Starting Godot...";
    private string _state = "starting";
    private string _scene = "-";
    private string _fps = "-";
    private string _renderer = "-";
    private string _driver = "-";
    private long _frames;

    // Blazor and Godot share one runtime: reach the scene tree directly.
    private void OnStarted(twodog.Engine engine)
    {
        _renderer = Godot.RenderingServer.GetCurrentRenderingMethod();
        _driver = Godot.RenderingServer.GetCurrentRenderingDriverName();
        (_status, _state) = ("Running", "running");
        _scene = engine.Tree.CurrentScene?.Name ?? "-";
    }

    private void OnFrame()
    {
        // The panel re-renders at a few Hz; the engine keeps rendering every frame regardless.
        if (++_frames % 30 != 0) return;
        _fps = Godot.Engine.GetFramesPerSecond().ToString("0");
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnExited() => (_status, _state) = ("Godot quit.", "stopped");

    private void OnFailed(Exception exception) => (_status, _state) = ($"Failed: {exception.Message}", "failed");
}
