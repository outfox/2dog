<Project Sdk="Godot.NET.Sdk/GODOT_SDK_VERSION">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTrimmable>true</IsTrimmable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <!-- TwoDogWebBoot.cs (web hosts) takes a function pointer to the source-generated plugins initializer;
             harmless on desktop -->
        <DefineConstants>$(DefineConstants);LIBGODOT_ENABLED</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Keep nested host projects out of the default compile/content globs (their .gdignore hides them
             from the Godot editor) -->
        <DefaultItemExcludes>$(DefaultItemExcludes);TPLRAWNAME.2dog/**;TPLRAWNAME.web/**;TPLRAWNAME.webxr/**;TPLRAWNAME.tests/**;TPLRAWNAME.winforms/**;TPLRAWNAME.winui/**;TPLRAWNAME.avalonia/**;TPLRAWNAME.blazor/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <!-- Web bootstrap lives in the web host folder but must compile into THIS assembly: scripts resolve
             from the assembly holding the source-generated plugins initializer. Inert without a web host -->
        <Compile Include="TPLRAWNAME.web/TwoDogWebBoot.cs"
                 Condition="Exists('$(MSBuildThisFileDirectory)TPLRAWNAME.web/TwoDogWebBoot.cs')"/>
        <!-- The webxr host carries its own copy; compile it only when the plain
             web host's is absent (one definition per assembly). -->
        <Compile Include="TPLRAWNAME.webxr/TwoDogWebBoot.cs"
                 Condition="!Exists('$(MSBuildThisFileDirectory)TPLRAWNAME.web/TwoDogWebBoot.cs') And Exists('$(MSBuildThisFileDirectory)TPLRAWNAME.webxr/TwoDogWebBoot.cs')"/>
        <!-- Same for the blazor host, last in line. -->
        <Compile Include="TPLRAWNAME.blazor/TwoDogWebBoot.cs"
                 Condition="!Exists('$(MSBuildThisFileDirectory)TPLRAWNAME.web/TwoDogWebBoot.cs') And !Exists('$(MSBuildThisFileDirectory)TPLRAWNAME.webxr/TwoDogWebBoot.cs') And Exists('$(MSBuildThisFileDirectory)TPLRAWNAME.blazor/TwoDogWebBoot.cs')"/>
    </ItemGroup>
</Project>
