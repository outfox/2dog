<Project>
    <PropertyGroup>
        <_TwoDogCoreBinding>$(MSBuildThisFileDirectory)../lib/net10.0/GodotSharp.dll</_TwoDogCoreBinding>
        <_TwoDogFallbackEditorBinding>$(MSBuildThisFileDirectory)api/GodotSharpEditor.dll</_TwoDogFallbackEditorBinding>
        <_TwoDogGenerator>$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/Godot.SourceGenerators.dll</_TwoDogGenerator>
        <_TwoDogExpectedEditorBinding Condition="'$(_TwoDogExpectedEditorBinding)' == ''">$(_TwoDogFallbackEditorBinding)</_TwoDogExpectedEditorBinding>
    </PropertyGroup>
    <!-- Keep the fork generator for Godot games and remove the SDK's duplicate, including on first restore. -->
    <Target Name="TwoDogSelectGodotGenerator" BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Godot.SourceGenerators'" />
            <Analyzer Include="$(_TwoDogGenerator)"
                      Condition="('$(UsingGodotNETSdk)' == 'true' Or '$(TwoDogEnableGodotSourceGenerators)' == 'true') And '$(TwoDogRemoveDuplicateGodotAnalyzers)' != 'true'" />
        </ItemGroup>
    </Target>

    <!-- Stock packages are normal inputs from Godot.NET.Sdk and third-party libraries. Check their Godot
         line, then choose the fork for compile/copy. Do not require consumer opt-out properties. -->
    <Target Name="TwoDogCheckBindingPackages" AfterTargets="ResolvePackageAssets">
        <ItemGroup>
            <_TwoDogStockBinding Include="@(ResolvedCompileFileDefinitions);@(RuntimeCopyLocalItems)"
                Condition="'%(NuGetPackageId)' == 'GodotSharp' Or '%(NuGetPackageId)' == 'GodotSharpEditor'">
                <GodotLine>$([System.Text.RegularExpressions.Regex]::Match('%(NuGetPackageVersion)', '^\d+\.\d+\.\d+').Value)</GodotLine>
            </_TwoDogStockBinding>
            <_TwoDogCorePackage Include="@(ResolvedCompileFileDefinitions)" Condition="'%(NuGetPackageId)' == '2dog.godotsharp'" />
            <_TwoDogEditorPackage Include="@(ResolvedCompileFileDefinitions)" Condition="'%(NuGetPackageId)' == '2dog.godotsharp.editor'" />
        </ItemGroup>
        <PropertyGroup>
            <_TwoDogCorePackageVersion>%(_TwoDogCorePackage.NuGetPackageVersion)</_TwoDogCorePackageVersion>
            <_TwoDogGodotLine>$([System.Text.RegularExpressions.Regex]::Match('$(_TwoDogCorePackageVersion)', '^\d+\.\d+\.\d+').Value)</_TwoDogGodotLine>
            <_TwoDogNeedsEditor Condition="'%(_TwoDogStockBinding.Filename)' == 'GodotSharpEditor' Or ('$(UsingGodotNETSdk)' == 'true' And ('$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Editor'))">true</_TwoDogNeedsEditor>
        </PropertyGroup>
        <Error Code="TDG001"
               Condition="'@(_TwoDogStockBinding)' != '' And '%(_TwoDogStockBinding.GodotLine)' != '$(_TwoDogGodotLine)'"
               Text="TwoDog: %(_TwoDogStockBinding.NuGetPackageId) %(_TwoDogStockBinding.NuGetPackageVersion) targets a different Godot version than 2dog $(_TwoDogCorePackageVersion). Align the Godot.NET.Sdk and library dependencies with Godot $(_TwoDogGodotLine)." />
        <Error Code="TDG004"
               Condition="'@(_TwoDogEditorPackage)' != '' And '%(_TwoDogEditorPackage.NuGetPackageVersion)' != '$(_TwoDogCorePackageVersion)'"
               Text="TwoDog: core and editor binding packages must have the same 2dog version." />
        <ItemGroup>
            <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(NuGetPackageId)' == 'GodotSharp' Or '%(NuGetPackageId)' == 'GodotSharpEditor'" />
            <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'GodotSharp' Or '%(NuGetPackageId)' == 'GodotSharpEditor'" />
            <_ReferenceDocumentationFiles Remove="@(_ReferenceDocumentationFiles)" Condition="'%(NuGetPackageId)' == 'GodotSharp' Or '%(NuGetPackageId)' == 'GodotSharpEditor'" />
            <Reference Include="GodotSharpEditor" Condition="'$(_TwoDogNeedsEditor)' == 'true' And '@(_TwoDogEditorPackage)' == ''">
                <HintPath>$(_TwoDogFallbackEditorBinding)</HintPath>
                <Private>true</Private>
            </Reference>
        </ItemGroup>
    </Target>

    <!-- Publish resolves package runtime assets afresh. Stock assets must not re-enter the publish set. -->
    <Target Name="TwoDogSelectPublishBindings" AfterTargets="_ComputeResolvedCopyLocalPublishAssets">
        <ItemGroup>
            <ResolvedCopyLocalPublishAssets Remove="@(ResolvedCopyLocalPublishAssets)"
                Condition="'%(NuGetPackageId)' == 'GodotSharp' Or '%(NuGetPackageId)' == 'GodotSharpEditor'" />
        </ItemGroup>
    </Target>

    <Target Name="TwoDogReadBindingHashes">
        <GetFileHash Files="$(MSBuildThisFileDirectory)../lib/net10.0/GodotSharp.dll" Algorithm="SHA256">
            <Output TaskParameter="Hash" PropertyName="_TwoDogCoreHash" />
        </GetFileHash>
        <GetFileHash Files="$(_TwoDogExpectedEditorBinding)" Algorithm="SHA256" Condition="'$(_TwoDogExpectedEditorBinding)' != ''">
            <Output TaskParameter="Hash" PropertyName="_TwoDogEditorHash" />
        </GetFileHash>
    </Target>

    <!-- Hashes also validate manually supplied references and project-output copies, without relying on
         assembly version or IsTrimmable metadata. Equal copies of the fork payload are allowed. -->
    <Target Name="TwoDogValidateCompileBindings" AfterTargets="ResolveReferences"
            BeforeTargets="CoreCompile" DependsOnTargets="TwoDogReadBindingHashes">
        <ItemGroup>
            <_TwoDogCompileBinding Include="@(ReferencePath);@(ReferenceCopyLocalPaths)"
                Condition="'%(Filename)%(Extension)' == 'GodotSharp.dll' Or '%(Filename)%(Extension)' == 'GodotSharpEditor.dll'" />
        </ItemGroup>
        <Error Code="TDG002"
               Condition="'%(_TwoDogCompileBinding.Filename)' == 'GodotSharpEditor' And '$(_TwoDogExpectedEditorBinding)' == ''"
               Text="TwoDog: GodotSharpEditor requires 2dog.godotsharp.editor at the same version as 2dog.engine. Remove stock package and HintPath references." />
        <GetFileHash Files="@(_TwoDogCompileBinding)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_TwoDogCompileBindingHash" />
        </GetFileHash>
        <Error Code="TDG003"
               Condition="'%(_TwoDogCompileBindingHash.Filename)' == 'GodotSharp' And '%(_TwoDogCompileBindingHash.FileHash)' != '$(_TwoDogCoreHash)'"
               Text="TwoDog: '%(_TwoDogCompileBindingHash.Identity)' differs from the packaged 2dog GodotSharp.dll. Remove conflicting references and rebuild every game/library project against 2dog.godotsharp." />
        <Error Code="TDG003"
               Condition="'%(_TwoDogCompileBindingHash.Filename)' == 'GodotSharpEditor' And '%(_TwoDogCompileBindingHash.FileHash)' != '$(_TwoDogEditorHash)'"
               Text="TwoDog: '%(_TwoDogCompileBindingHash.Identity)' differs from the packaged 2dog GodotSharpEditor.dll. Use 2dog.godotsharp.editor at the engine version." />
    </Target>

    <!-- Validate original publish inputs before ILLink rewrites them; this also runs for publishes that skip the build. -->
    <Target Name="TwoDogValidatePublishBindings" AfterTargets="ComputeResolvedFilesToPublishList"
            BeforeTargets="ILLink" DependsOnTargets="TwoDogReadBindingHashes">
        <ItemGroup>
            <_TwoDogPublishBinding Include="@(ResolvedFileToPublish)"
                Condition="'%(Filename)%(Extension)' == 'GodotSharp.dll' Or '%(Filename)%(Extension)' == 'GodotSharpEditor.dll'" />
        </ItemGroup>
        <Error Code="TDG002"
               Condition="'%(_TwoDogPublishBinding.Filename)' == 'GodotSharpEditor' And '$(_TwoDogExpectedEditorBinding)' == ''"
               Text="TwoDog: GodotSharpEditor requires 2dog.godotsharp.editor at the same version as 2dog.engine. Remove stock package and HintPath references." />
        <GetFileHash Files="@(_TwoDogPublishBinding)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_TwoDogPublishBindingHash" />
        </GetFileHash>
        <Error Code="TDG003"
               Condition="'%(_TwoDogPublishBindingHash.Filename)' == 'GodotSharp' And '%(_TwoDogPublishBindingHash.FileHash)' != '$(_TwoDogCoreHash)'"
               Text="TwoDog: '%(_TwoDogPublishBindingHash.Identity)' differs from the packaged 2dog GodotSharp.dll. Remove conflicting references and rebuild every game/library project against 2dog.godotsharp." />
        <Error Code="TDG003"
               Condition="'%(_TwoDogPublishBindingHash.Filename)' == 'GodotSharpEditor' And '%(_TwoDogPublishBindingHash.FileHash)' != '$(_TwoDogEditorHash)'"
               Text="TwoDog: '%(_TwoDogPublishBindingHash.Identity)' differs from the packaged 2dog GodotSharpEditor.dll. Use 2dog.godotsharp.editor at the engine version." />
    </Target>
</Project>
