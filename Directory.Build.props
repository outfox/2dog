<Project>
    <PropertyGroup>
        <!-- Godot engine version. Must match the godot submodule (godot/version.py). -->
        <GodotVersion>4.7.1</GodotVersion>
        <!-- Global 2dog iteration, shared across ALL supported Godot lines.
             Bump every 2dog release; never reset when GodotVersion changes:
             e.g. 4.6.2.31 and 4.7.0.31 are the same 2dog iteration. -->
        <TwoDogRevision>73</TwoDogRevision>
        <!-- Native package revision. Bump when the godot submodule changes OR
             when the natives package layout/metadata changes (the deploy job's
             skip-duplicate push would otherwise keep the old package);
             reset to 0 when GodotVersion changes. NuGet normalizes a trailing .0
             (4.7.0.0 publishes as 4.7.0). -->
        <NativesRevision>39</NativesRevision>
        <TwoDogVersion>$(GodotVersion).$(TwoDogRevision)</TwoDogVersion>
        <NativesVersion>$(GodotVersion).$(NativesRevision)</NativesVersion>
        <!-- Avalonia for the 2dog.avalonia package and its in-repo consumers. Mixed Avalonia
             versions fail at runtime, so bump it in one place. (The template consumes it via
             its AVALONIA_PKG_VERSION token, substituted on pack and scaffold.) -->
        <AvaloniaVersion>12.1.1</AvaloniaVersion>
        <!-- Windows App SDK for the WinUI 3 host demo. (The template consumes it via its
             WINAPPSDK_PKG_VERSION token, substituted on pack and scaffold.) -->
        <WindowsAppSdkVersion>2.4.0</WindowsAppSdkVersion>
        <!-- Emscripten version for browser-wasm natives. Must match the emscripten
             the .NET browser-wasm runtime pack was built with (the web libgodot.a is
             statically linked into dotnet.native.wasm, so the toolchains must agree).
             Source of truth: microsoft.net.workload.emscripten.current manifest of the
             SDK band used by web hosts (net10.0). -->
        <EmscriptenVersion>3.1.56</EmscriptenVersion>
        <!-- Allow running on any .NET 10+ runtime (10, 11, ...) -->
        <RollForward>LatestMajor</RollForward>
    </PropertyGroup>

    <!-- Fork build output consumed by twodog.engine, twodog.import, and twodog.avalonia.
         Consumers append the API config flavor (Release/, Debug/) themselves. -->
    <PropertyGroup>
        <TwoDogGodotBinDir Condition="'$(TwoDogGodotBinDir)' == ''">$(MSBuildThisFileDirectory)godot/bin/</TwoDogGodotBinDir>
        <TwoDogGodotSharpApiDir Condition="'$(TwoDogGodotSharpApiDir)' == ''">$(TwoDogGodotBinDir)GodotSharp/Api/</TwoDogGodotSharpApiDir>
    </PropertyGroup>

    <!-- Shared NuGet package metadata; packable projects only add what
         differs (id, description, tags, icon/readme includes). -->
    <PropertyGroup>
        <Authors>Moritz Voss</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/outfox/2dog</PackageProjectUrl>
        <PackageOutputPath>$(MSBuildThisFileDirectory)packages/</PackageOutputPath>
    </PropertyGroup>
</Project>
