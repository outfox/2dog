<Project>
    <PropertyGroup>
        <!-- The next four are written by scripts/release.nu; do not edit them by hand.
             Godot's C# package version of the godot submodule (godot/version.py status "beta2" -> 4.8.0-beta.2). -->
        <GodotVersion>4.7.2</GodotVersion>
        <!-- Release number, one counter across all release branches (the next number after every v* tag). -->
        <TwoDogRevision>165</TwoDogRevision>
        <!-- The release whose native packages this line reuses; a release whose native inputs differ from that
             release's tag sets its own number. -->
        <NativesRevision>165</NativesRevision>
        <!-- Prerelease label: Godot's status for a Godot prerelease (4.8.0.156-beta2), else the release branch label
             (4.7-rc releases 4.7.2.N-rc); empty for stable releases. -->
        <TwoDogPrerelease></TwoDogPrerelease>
    </PropertyGroup>
    <!-- Imported suffixes apply only to the checkout versions recorded by pull-packages. -->
    <Import Project="$(MSBuildThisFileDirectory)packages/ci-packages.props"
            Condition="'$(GITHUB_ACTIONS)' != 'true' And Exists('$(MSBuildThisFileDirectory)packages/ci-packages.props')"/>
    <PropertyGroup>
        <!-- 2dog versions take Godot's release numbers; the label carries the rest (4.8.0-beta.2 -> 4.8.0.156-beta2). -->
        <TwoDogGodotRelease>$([System.Text.RegularExpressions.Regex]::Replace('$(GodotVersion)', '-.*', ''))</TwoDogGodotRelease>
        <!-- CI builds other than release tags must never carry a published version (a cached or nuget.org copy would
             stand in for their bits). A ci label sorts them between the release they follow and the next one:
             4.8.0.163-beta3.ci.812 (a longer label sorts higher), 4.7.2.165-ci.812 (no label: the next revision). -->
        <TwoDogBuildSuffix Condition="'$(TwoDogBuildSuffix)' == '' And '$(GITHUB_ACTIONS)' == 'true' And !$([System.String]::Copy('$(GITHUB_REF)').StartsWith('refs/tags/v'))">ci.$(GITHUB_RUN_ID)</TwoDogBuildSuffix>
        <TwoDogBuildRevision>$(TwoDogRevision)</TwoDogBuildRevision>
        <TwoDogBuildRevision Condition="'$(TwoDogBuildSuffix)' != '' And '$(TwoDogPrerelease)' == ''">$([MSBuild]::Add($(TwoDogRevision), 1))</TwoDogBuildRevision>
        <TwoDogBuildNatives>$(NativesRevision)</TwoDogBuildNatives>
        <TwoDogBuildNatives Condition="'$(TwoDogBuildSuffix)' != ''">$([MSBuild]::Add($(NativesRevision), 1))</TwoDogBuildNatives>
        <TwoDogVersion>$(TwoDogGodotRelease).$(TwoDogBuildRevision)</TwoDogVersion>
        <TwoDogVersion Condition="'$(TwoDogPrerelease)' != ''">$(TwoDogVersion)-$(TwoDogPrerelease)</TwoDogVersion>
        <TwoDogVersion Condition="'$(TwoDogBuildSuffix)' != '' And '$(TwoDogPrerelease)' != ''">$(TwoDogVersion).$(TwoDogBuildSuffix)</TwoDogVersion>
        <TwoDogVersion Condition="'$(TwoDogBuildSuffix)' != '' And '$(TwoDogPrerelease)' == ''">$(TwoDogVersion)-$(TwoDogBuildSuffix)</TwoDogVersion>
        <NativesVersion>$(TwoDogGodotRelease).$(TwoDogBuildNatives)</NativesVersion>
        <NativesVersion Condition="'$(TwoDogBuildSuffix)' != ''">$(NativesVersion)-$(TwoDogBuildSuffix)</NativesVersion>
        <!-- Mixed Avalonia versions fail at runtime, so bump in one place. The template consumes it via its
             AVALONIA_PKG_VERSION token, substituted on pack and scaffold. -->
        <AvaloniaVersion>12.1.1</AvaloniaVersion>
        <!-- MAUI controls shared by the library and generated hosts. -->
        <MauiVersion>10.0.110</MauiVersion>
        <!-- Windows App SDK for the WinUI 3 host demo. (The template consumes it via its
             WINAPPSDK_PKG_VERSION token, substituted on pack and scaffold.) -->
        <WindowsAppSdkVersion>2.4.0</WindowsAppSdkVersion>
        <!-- ASP.NET Core (Blazor) packages for 2dog.blazor and the Blazor host. (The template consumes it via its
             ASPNETCORE_PKG_VERSION token, substituted on pack and scaffold.) Floats on the patch level, so every
             restore takes the newest 10.0 servicing release and its security fixes. -->
        <AspNetCoreVersion>10.0.*</AspNetCoreVersion>
        <!-- Qt Bridge for C# (pre-release) for the Qt Quick host demo. Its packages are per RID; only win-x64 bundles Qt. -->
        <QtBridgeVersion>0.4.0-beta</QtBridgeVersion>
        <!-- Must match the emscripten of the .NET browser-wasm runtime pack (libgodot.a links into dotnet.native.wasm).
             Source of truth: microsoft.net.workload.emscripten.current manifest of the net10.0 SDK band. -->
        <EmscriptenVersion>3.1.56</EmscriptenVersion>
        <!-- Allow running on any .NET 10+ runtime (10, 11, ...) -->
        <RollForward>LatestMajor</RollForward>
    </PropertyGroup>

    <!-- Precision is independent of Debug/Release/Editor. Only ABI-dependent packages get a suffix. -->
    <PropertyGroup>
        <TwoDogPrecision Condition="'$(TwoDogPrecision)' == ''">single</TwoDogPrecision>
        <TwoDogPackageSuffix Condition="'$(TwoDogPrecision)' == 'double'">.double</TwoDogPackageSuffix>
        <TwoDogNativePrecisionSuffix Condition="'$(TwoDogPrecision)' == 'double'">.double</TwoDogNativePrecisionSuffix>
        <TwoDogNativeOutputSubdir Condition="'$(TwoDogPrecision)' == 'double'">double/</TwoDogNativeOutputSubdir>
        <GodotFloat64 Condition="'$(TwoDogPrecision)' == 'double'">true</GodotFloat64>
        <DefineConstants Condition="'$(TwoDogPrecision)' == 'double'">$(DefineConstants);REAL_T_IS_DOUBLE</DefineConstants>
        <!-- One tree builds every Godot line (godot-lines.json): guard calls only a newer Godot has with Godot.NET.Sdk's
             own constant names, which 2dog's libraries do not get from that SDK. -->
        <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(TwoDogGodotRelease)', '4.8'))">$(DefineConstants);GODOT4_8_OR_GREATER</DefineConstants>
        <BaseIntermediateOutputPath Condition="'$(TwoDogPrecision)' == 'double'">obj/double/</BaseIntermediateOutputPath>
        <BaseOutputPath Condition="'$(TwoDogPrecision)' == 'double'">bin/double/</BaseOutputPath>
        <!-- Both precision trees can exist in one checkout. Exclude the whole artifact roots,
             even when the SDK's default exclusion follows obj/double or bin/double. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    </PropertyGroup>

    <!-- Fork build output consumed by twodog.engine, twodog.import, and twodog.avalonia.
         Consumers append the API config flavor (Release/, Debug/) themselves. -->
    <PropertyGroup>
        <TwoDogGodotBinDir Condition="'$(TwoDogGodotBinDir)' == ''">$(MSBuildThisFileDirectory)godot/bin/$(TwoDogNativeOutputSubdir)</TwoDogGodotBinDir>
        <TwoDogGodotSharpApiDir Condition="'$(TwoDogGodotSharpApiDir)' == ''">$(TwoDogGodotBinDir)GodotSharp/Api/</TwoDogGodotSharpApiDir>
    </PropertyGroup>

    <!-- Shared NuGet package metadata; packable projects only add what
         differs (id, description, tags, icon/readme includes). -->
    <PropertyGroup>
        <Authors>Moritz Voss</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/outfox/2dog</PackageProjectUrl>
        <PackageOutputPath>$(MSBuildThisFileDirectory)packages/</PackageOutputPath>
    </PropertyGroup>
</Project>
