<Project>
    <PropertyGroup>
        <!-- Godot engine version. Must match the godot submodule (godot/version.py). -->
        <GodotVersion>4.7.2</GodotVersion>
        <!-- Global 2dog iteration shared across all Godot lines (4.6.2.31 and 4.7.0.31 are the same iteration).
             Bump every release; never reset when GodotVersion changes. -->
        <TwoDogRevision>148</TwoDogRevision>
        <!-- Bump when the godot submodule or the natives package layout changes (deploy skips duplicates);
             reset to 0 when GodotVersion changes. NuGet normalizes a trailing .0 (4.7.0.0 publishes as 4.7.0). -->
        <NativesRevision>59</NativesRevision>
        <TwoDogVersion>$(GodotVersion).$(TwoDogRevision)</TwoDogVersion>
        <NativesVersion>$(GodotVersion).$(NativesRevision)</NativesVersion>
        <!-- Mixed Avalonia versions fail at runtime, so bump in one place. The template consumes it via its
             AVALONIA_PKG_VERSION token, substituted on pack and scaffold. -->
        <AvaloniaVersion>12.1.1</AvaloniaVersion>
        <!-- MAUI controls shared by the library and generated hosts. -->
        <MauiVersion>10.0.110</MauiVersion>
        <!-- Windows App SDK for the WinUI 3 host demo. (The template consumes it via its
             WINAPPSDK_PKG_VERSION token, substituted on pack and scaffold.) -->
        <WindowsAppSdkVersion>2.4.0</WindowsAppSdkVersion>
        <!-- ASP.NET Core (Blazor) packages for 2dog.blazor and the Blazor host. (The template consumes it via its
             ASPNETCORE_PKG_VERSION token, substituted on pack and scaffold.) Floats on the patch level, so every
             restore takes the newest 10.0 servicing release and its security fixes. -->
        <AspNetCoreVersion>10.0.*</AspNetCoreVersion>
        <!-- Qt Bridge for C# (pre-release) for the Qt Quick host demo. Its packages are per RID; only win-x64 bundles Qt. -->
        <QtBridgeVersion>0.4.0-beta</QtBridgeVersion>
        <!-- Must match the emscripten of the .NET browser-wasm runtime pack (libgodot.a links into dotnet.native.wasm).
             Source of truth: microsoft.net.workload.emscripten.current manifest of the net10.0 SDK band. -->
        <EmscriptenVersion>3.1.56</EmscriptenVersion>
        <!-- Allow running on any .NET 10+ runtime (10, 11, ...) -->
        <RollForward>LatestMajor</RollForward>
    </PropertyGroup>

    <!-- Precision is independent of Debug/Release/Editor. Only ABI-dependent packages get a suffix. -->
    <PropertyGroup>
        <TwoDogPrecision Condition="'$(TwoDogPrecision)' == ''">single</TwoDogPrecision>
        <TwoDogPackageSuffix Condition="'$(TwoDogPrecision)' == 'double'">.double</TwoDogPackageSuffix>
        <TwoDogNativePrecisionSuffix Condition="'$(TwoDogPrecision)' == 'double'">.double</TwoDogNativePrecisionSuffix>
        <TwoDogNativeOutputSubdir Condition="'$(TwoDogPrecision)' == 'double'">double/</TwoDogNativeOutputSubdir>
        <GodotFloat64 Condition="'$(TwoDogPrecision)' == 'double'">true</GodotFloat64>
        <DefineConstants Condition="'$(TwoDogPrecision)' == 'double'">$(DefineConstants);REAL_T_IS_DOUBLE</DefineConstants>
        <BaseIntermediateOutputPath Condition="'$(TwoDogPrecision)' == 'double'">obj/double/</BaseIntermediateOutputPath>
        <BaseOutputPath Condition="'$(TwoDogPrecision)' == 'double'">bin/double/</BaseOutputPath>
        <!-- Both precision trees can exist in one checkout. Exclude the whole artifact roots,
             even when the SDK's default exclusion follows obj/double or bin/double. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    </PropertyGroup>

    <!-- Fork build output consumed by twodog.engine, twodog.import, and twodog.avalonia.
         Consumers append the API config flavor (Release/, Debug/) themselves. -->
    <PropertyGroup>
        <TwoDogGodotBinDir Condition="'$(TwoDogGodotBinDir)' == ''">$(MSBuildThisFileDirectory)godot/bin/$(TwoDogNativeOutputSubdir)</TwoDogGodotBinDir>
        <TwoDogGodotSharpApiDir Condition="'$(TwoDogGodotSharpApiDir)' == ''">$(TwoDogGodotBinDir)GodotSharp/Api/</TwoDogGodotSharpApiDir>
    </PropertyGroup>

    <!-- Shared NuGet package metadata; packable projects only add what
         differs (id, description, tags, icon/readme includes). -->
    <PropertyGroup>
        <Authors>Moritz Voss</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/outfox/2dog</PackageProjectUrl>
        <PackageOutputPath>$(MSBuildThisFileDirectory)packages/</PackageOutputPath>
    </PropertyGroup>
</Project>
