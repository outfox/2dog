<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- The Android target needs the android workload and an SDK; TwoDogMauiAndroid=false skips it (an iOS-only Mac). -->
        <TargetFrameworks Condition="'$(TwoDogMauiAndroid)' != 'false'">net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
        <!-- The iOS target needs the maui-ios and ios workloads: always on a Mac, opt-in elsewhere (the Windows
             pack job passes TwoDogMauiIos=true; class libraries build there without a Mac). -->
        <TwoDogMauiIos Condition="'$(TwoDogMauiIos)' == '' And $([MSBuild]::IsOSPlatform('osx'))">true</TwoDogMauiIos>
        <TargetFrameworks Condition="'$(TwoDogMauiIos)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks.TrimStart(';'))</TargetFrameworks>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'android'">24</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'ios'">15.0</SupportedOSPlatformVersion>
        <PackageId>2dog.maui</PackageId>
        <Version>$(TwoDogVersion)</Version>
        <TwoDogPrecisionNeutral>true</TwoDogPrecisionNeutral>
        <Description>Embed Godot in .NET MAUI on Windows, Android and iOS (experimental) with GPU presentation and MAUI overlays.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>godot;2dog;maui;android;ios;winui;game-engine</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <AndroidJavaSource Remove="Platforms/Android/**/*.java"/>
        <ProjectReference Include="../twodog.engine/twodog.engine.csproj" PrivateAssets="all"/>
        <!-- The iOS handler hosts Godot's view controller through 2dog.ios, which consumers get transitively. -->
        <ProjectReference Include="../twodog.ios/twodog.ios.csproj" Condition="'$(TargetPlatformIdentifier)' == 'ios'"/>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <None Include="../nuget/icon.png" Pack="true" PackagePath="icon.png"/>
        <None Include="README.md" Pack="true" PackagePath="README.md"/>
        <None Include="buildTransitive/2dog.maui.targets" Pack="true" PackagePath="buildTransitive/"/>
        <None Include="Platforms/Android/TwoDogMauiFragment.java" Pack="true" PackagePath="android/"/>
        <None Include="Platforms/Android/proguard.cfg" Pack="true" PackagePath="android/"/>
    </ItemGroup>
    <!-- Share the low-level DXGI ABI with Avalonia; no Avalonia dependency in this package. -->
    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
        <Compile Include="../twodog.avalonia/Presentation/D3D11Interop.cs" Link="Platforms/Windows/D3D11Interop.cs"/>
        <Compile Include="../twodog.avalonia/Presentation/DefaultAdapter.cs" Link="Platforms/Windows/DefaultAdapter.cs"/>
    </ItemGroup>
</Project>
