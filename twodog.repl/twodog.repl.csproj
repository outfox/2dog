<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Keep symbols with the packaged host for debugging and coverage of the actual NuGet assembly. -->
        <DebugType>embedded</DebugType>
        <PackageId>2dog.repl</PackageId>
        <Version>$(TwoDogVersion)</Version>
        <!-- One package works with either engine precision; the host selects its engine explicitly. -->
        <TwoDogPrecisionNeutral>true</TwoDogPrecisionNeutral>
        <Description>A terminal C# REPL inside a running Godot engine, with completion, highlighting and history.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>godot;2dog;repl;csharp</PackageTags>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="2dog.engine$(TwoDogPackageSuffix)" Version="[$(TwoDogVersion)]" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.3.0" />
        <InternalsVisibleTo Include="twodog.tests" />
    </ItemGroup>
    <ItemGroup>
        <!-- The agent guide behind ':help agents'; the 2dog tool links the same file for '2dog skill'. -->
        <EmbeddedResource Include="Agents/repl-guide.md" LogicalName="twodog.repl.repl-guide.md" />
    </ItemGroup>
    <ItemGroup>
        <None Include="../nuget/icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="README.md" />
        <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
        <None Include="licenses/*" Pack="true" PackagePath="licenses/" />
        <None Include="buildTransitive/2dog.repl.targets" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>
</Project>
