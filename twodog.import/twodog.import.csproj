<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RollForward>LatestMajor</RollForward>
        <AssemblyName>2dog.import</AssemblyName>
    </PropertyGroup>

    <!-- Copy-local so the default ALC satisfies GodotPlugins' Assembly.Load("GodotSharp"/"GodotSharpEditor").
         Api Debug config matches GDMono::get_expected_api_build_config() for editor builds. -->
    <ItemGroup>
        <Reference Include="GodotSharp">
            <HintPath>$([MSBuild]::EnsureTrailingSlash('$(TwoDogGodotSharpApiDir)'))Debug/GodotSharp.dll</HintPath>
        </Reference>
        <Reference Include="GodotSharpEditor">
            <HintPath>$([MSBuild]::EnsureTrailingSlash('$(TwoDogGodotSharpApiDir)'))Debug/GodotSharpEditor.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
