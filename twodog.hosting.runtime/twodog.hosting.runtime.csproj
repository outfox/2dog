<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>twodog.Hosting.Runtime</RootNamespace>
        <AssemblyName>twodog.hosting.runtime</AssemblyName>
        <IsPackable>false</IsPackable>
        <!-- No Godot script classes and no Godot project: the source generators have nothing to do here. -->
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
    </PropertyGroup>

    <!-- Loaded per instance-ALC (references Godot types); never in the shared list. -->
    <ItemGroup>
        <ProjectReference Include="..\twodog.hosting\twodog.hosting.csproj" />
        <PackageReference Include="2dog.engine" Version="$(TwoDogVersion)" />
    </ItemGroup>

</Project>
