<Project>
    <!-- Writes version defaults into the dotnet-new template's template.json; used by twodog.templates/twodog.templates.csproj. -->
    <UsingTask TaskName="SetTemplateDefaults" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
               Condition="'$(MSBuildProjectName)' == 'twodog.templates'">
        <ParameterGroup>
            <FilePath ParameterType="System.String" Required="true" />
            <TwoDogVer ParameterType="System.String" Required="true" />
            <NativesVer ParameterType="System.String" Required="true" />
            <GodotVer ParameterType="System.String" Required="true" />
            <AvaloniaVer ParameterType="System.String" Required="true" />
            <MauiVer ParameterType="System.String" Required="true" />
            <WinAppSdkVer ParameterType="System.String" Required="true" />
            <AspNetCoreVer ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var text = File.ReadAllText(FilePath);
                // Fail the build if a symbol is not found: a silent no-op would ship placeholder versions.
                var substitutions = new (string Symbol, string Value)[] {
                    ("twodogVersion", TwoDogVer),
                    ("nativesVersion", NativesVer),
                    ("godotVersion", GodotVer),
                    ("avaloniaVersion", AvaloniaVer),
                    ("mauiVersion", MauiVer),
                    ("winAppSdkVersion", WinAppSdkVer),
                    ("aspNetCoreVersion", AspNetCoreVer),
                };
                foreach (var (symbol, value) in substitutions)
                {
                    var regex = new System.Text.RegularExpressions.Regex(
                        "(\"" + symbol + "\"[^}]*\"defaultValue\":\\s*)\"[^\"]*\"");
                    if (!regex.IsMatch(text))
                        throw new System.Exception(
                            $"SetTemplateDefaults: no defaultValue found for symbol '{symbol}' in '{FilePath}'. " +
                            "The template.json layout may have changed; update the regex in Directory.Build.targets.");
                    text = regex.Replace(text, "${1}\"" + value + "\"");
                }
                File.WriteAllText(FilePath, text);
            ]]></Code>
        </Task>
    </UsingTask>

    <!-- Gitignored template files never reach a CI checkout and silently vanish from the pack (4.7.0.36 shipped
         without export_presets.cfg that way). -->
    <Target Name="VerifyEmbeddedTemplateTracked" BeforeTargets="GenerateNuspec"
            Condition="'$(MSBuildProjectName)' == 'twodog' Or '$(MSBuildProjectName)' == 'twodog.templates'">
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)/../&quot; ls-files --others templates/twodog/"
              ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_TwoDogCliTemplateUntracked"/>
            <Output TaskParameter="ExitCode" PropertyName="_TwoDogCliTemplateGitExit"/>
        </Exec>
        <Error Condition="'$(_TwoDogCliTemplateGitExit)' == '0' And '$(_TwoDogCliTemplateUntracked.Trim())' != ''"
               Text="2dog template content contains files git does not track (gitignored or never added) - they would be missing from a CI-packed $(PackageId) package: $(_TwoDogCliTemplateUntracked)"/>
    </Target>

    <!-- nuget.config lists godot/bin/GodotSharp/Tools/nupkgs as a source, but it only exists after a glue build. -->
    <Target Name="TwoDogEnsureLocalNugetSource" BeforeTargets="Restore;CollectPackageReferences">
        <MakeDir Directories="$(MSBuildThisFileDirectory)godot/bin/GodotSharp/Tools/nupkgs" />
    </Target>

    <!-- Restore extracts each package version once and never refreshes it. Local packs reuse unpublished versions
         with new content, so drop this version's extraction; the next restore unpacks the new package. Only
         `dotnet pack` (_IsPacking) does this: builds also pack platform packages that the same build consumes. -->
    <Target Name="TwoDogInvalidatePackedVersion" AfterTargets="Pack"
            Condition="'$(NuGetPackageRoot)' != '' And '$(_IsPacking)' == 'true'">
        <RemoveDir Directories="$(NuGetPackageRoot)$(PackageId.ToLowerInvariant())/$(PackageVersion.ToLowerInvariant())"
                   ContinueOnError="WarnAndContinue" />
    </Target>

    <!-- Keep the repository clean across configuration changes. -->
    <Target Name="TwoDogDeepClean" AfterTargets="Clean">
        <RemoveDir Directories="$(BaseIntermediateOutputPath)" />
        <RemoveDir Directories="$(BaseOutputPath)" />
    </Target>
    <Import Project="build/2dog.precision-pack.targets" />
</Project>
