<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RollForward>LatestMajor</RollForward>
        <AssemblyName>2dog</AssemblyName>
        <RootNamespace>twodog.cli</RootNamespace>
    </PropertyGroup>

    <!-- dotnet tool AND dotnet-new template in one package; packing needs the .NET 10 SDK (dotnet/sdk#48039).
         A DotnetTool package can never be a PackageReference (NU1213), hence the separate 2dog.engine. -->
    <PropertyGroup>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>2dog</ToolCommandName>
        <PackageId>2dog</PackageId>
        <PackageType>DotnetTool;Template</PackageType>
        <Version>$(TwoDogVersion)</Version>
        <Description>2dog command-line tool and project templates. `dnx 2dog new MyGame` interactively creates a Godot project with .NET hosts; `2dog add` adds hosts (desktop, browser-wasm, xUnit, WinForms, WinUI 3, Avalonia, Blazor) to an existing one; every prompt has a flag, so `2dog new MyGame --desktop --tests` runs unattended. `2dog pack list` inspects an exported .pck. `dotnet new install 2dog` provides the `dotnet new 2dog` project template. The engine library itself is the 2dog.engine package.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsPackable>true</IsPackable>
        <!-- Suppress NU5128: template content folder doesn't need contentFiles metadata -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <!-- Include dotfiles (.gdignore, .editorconfig, .gitignore, .template.config) in the package -->
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <PackageTags>dotnet-tool;dotnet-new;templates;godot;2dog;game-engine</PackageTags>
    </PropertyGroup>

    <!-- Interactive host picker. Keep Spectre the only dependency so `dnx 2dog` stays a small download. -->
    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.57.2"/>
    </ItemGroup>

    <!-- GDPC pack reader behind `2dog pack list`, shared with twodog.import's list-pack mode. -->
    <ItemGroup>
        <Compile Include="../twodog.import/GdpcPack.cs" Link="GdpcPack.cs"/>
    </ItemGroup>

    <!-- The versions the tool scaffolds with, baked in at build time -->
    <ItemGroup>
        <AssemblyMetadata Include="TwoDogVersion" Value="$(TwoDogVersion)"/>
        <AssemblyMetadata Include="NativesVersion" Value="$(NativesVersion)"/>
        <AssemblyMetadata Include="GodotSdkVersion" Value="$(GodotVersion)"/>
        <AssemblyMetadata Include="AvaloniaVersion" Value="$(AvaloniaVersion)"/>
        <AssemblyMetadata Include="WindowsAppSdkVersion" Value="$(WindowsAppSdkVersion)"/>
        <AssemblyMetadata Include="AspNetCoreVersion" Value="$(AspNetCoreVersion)"/>
    </ItemGroup>

    <!-- Embed the template's host subtrees verbatim (tokens substituted at runtime). The sln is NOT embedded
         (dotnet-new #if blocks); `2dog add` shells out to `dotnet sln` instead. -->
    <PropertyGroup>
        <!-- Local builds leave artifacts in the template folders; VerifyEmbeddedTemplateTracked only guards pack. -->
        <_TwoDogCliTplExcludes>../templates/twodog/**/bin/**;../templates/twodog/**/obj/**;../templates/twodog/**/TestResults/**</_TwoDogCliTplExcludes>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.2dog/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.2dog/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.web/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.web/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.webxr/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.webxr/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.tests/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.tests/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.winforms/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.winforms/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.winui/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.winui/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.avalonia/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.avalonia/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.blazor/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.blazor/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.csproj" LogicalName="tpl/Company.Product1.csproj"/>
        <EmbeddedResource Include="../templates/twodog/Directory.Build.targets" LogicalName="tpl/Directory.Build.targets"/>
        <EmbeddedResource Include="../templates/twodog/export_presets.cfg" LogicalName="tpl/export_presets.cfg"/>
        <EmbeddedResource Include="../templates/twodog/global.json" LogicalName="tpl/global.json"/>
        <!-- Godot project files, for `2dog new` -->
        <EmbeddedResource Include="../templates/twodog/project.godot" LogicalName="tpl/project.godot"/>
        <EmbeddedResource Include="../templates/twodog/main.tscn" LogicalName="tpl/main.tscn"/>
        <EmbeddedResource Include="../templates/twodog/.editorconfig" LogicalName="tpl/.editorconfig"/>
        <EmbeddedResource Include="../templates/twodog/.gitignore" LogicalName="tpl/.gitignore"/>
    </ItemGroup>

    <!-- Unit tests in twodog.tests exercise the internal conversion pipeline -->
    <ItemGroup>
        <InternalsVisibleTo Include="twodog.tests"/>
    </ItemGroup>

    <!-- Package icon and readme -->
    <ItemGroup>
        <None Include="../nuget/icon.png" Pack="true" PackagePath="icon.png" Visible="false"/>
        <None Include="README.md" Pack="true" PackagePath="README.md"/>
    </ItemGroup>

    <!-- The Template half of the package. template.json is replaced by a versioned copy staged into obj/
         (StageVersionedTemplateJson), so the committed file keeps its placeholders. -->
    <ItemGroup>
        <Content Include="../templates/twodog/**/*" Exclude="../templates/twodog/**/bin/**;../templates/twodog/**/obj/**;../templates/twodog/.template.config/template.json"
                 Pack="true" PackagePath="content/twodog/" CopyToOutputDirectory="Never"/>
    </ItemGroup>

    <!-- Gitignored template files never reach a CI checkout and silently vanish from the pack (4.7.0.36 shipped
         without export_presets.cfg that way). -->
    <Target Name="VerifyEmbeddedTemplateTracked" BeforeTargets="GenerateNuspec">
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)/../&quot; ls-files --others templates/twodog/"
              ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_TwoDogCliTemplateUntracked"/>
            <Output TaskParameter="ExitCode" PropertyName="_TwoDogCliTemplateGitExit"/>
        </Exec>
        <Error Condition="'$(_TwoDogCliTemplateGitExit)' == '0' And '$(_TwoDogCliTemplateUntracked.Trim())' != ''"
               Text="2dog template content contains files git does not track (gitignored or never added) - they would be missing from a CI-packed 2dog package: $(_TwoDogCliTemplateUntracked)"/>
    </Target>

    <!-- Pack a copy of template.json with real versions substituted; the committed file keeps its 0.0.0-*tpl
         placeholders. SetTemplateDefaults lives in the repo-root Directory.Build.targets. -->
    <Target Name="StageVersionedTemplateJson" BeforeTargets="_GetPackageFiles;GenerateNuspec">
        <Copy SourceFiles="../templates/twodog/.template.config/template.json"
              DestinationFiles="$(IntermediateOutputPath)template.json"/>
        <SetTemplateDefaults FilePath="$(IntermediateOutputPath)template.json"
                             TwoDogVer="$(TwoDogVersion)"
                             NativesVer="$(NativesVersion)"
                             GodotVer="$(GodotVersion)"
                             AvaloniaVer="$(AvaloniaVersion)"
                             WinAppSdkVer="$(WindowsAppSdkVersion)"
                             AspNetCoreVer="$(AspNetCoreVersion)" />
        <ItemGroup>
            <None Include="$(IntermediateOutputPath)template.json" Pack="true"
                  PackagePath="content/twodog/.template.config/template.json"/>
        </ItemGroup>
    </Target>

</Project>
