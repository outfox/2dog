<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RollForward>LatestMajor</RollForward>
        <AssemblyName>2dog</AssemblyName>
        <RootNamespace>twodog.cli</RootNamespace>
        <!-- System.CommandLine ships localized resource assemblies; the tool's own text is English only -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <!-- A DotnetTool package cannot be a PackageReference (NU1213), hence the separate 2dog.engine. -->
    <PropertyGroup>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>2dog</ToolCommandName>
        <PackageId>2dog</PackageId>
        <PackageType>DotnetTool</PackageType>
        <Version>$(TwoDogVersion)</Version>
        <Description>2dog is Godot in .NET! This is the 2dog .NET Tool. `dnx 2dog new MyGame` interactively creates a Godot project with .NET hosts; `2dog add` adds hosts (desktop, browser-wasm, xUnit, NUnit, GdUnit, WinForms, WinUI 3, Avalonia, Qt Quick, Blazor, Android, iOS, MAUI) to an existing one; every prompt has a flag, so `2dog new MyGame --generic --xunit` runs unattended. `2dog doctor` checks the project and the machine, applies safe fixes and explains build failures; `2dog update` brings the 2dog packages to the tool's versions. `2dog pack list` inspects an exported .pck. `dotnet new install 2dog.templates` provides the `dotnet new 2dog` project template. The engine library itself is the 2dog.engine package.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsPackable>true</IsPackable>
        <PackageTags>dotnet-tool;godot;2dog;game-engine;.NET Tool;tool</PackageTags>
    </PropertyGroup>

    <!-- Interactive host picker (Spectre) and the command tree (System.CommandLine, zero further deps): the only two
         dependencies, so `dnx 2dog` stays a small download. -->
    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.57.2"/>
        <PackageReference Include="System.CommandLine" Version="2.0.11"/>
    </ItemGroup>

    <!-- GDPC pack reader behind `2dog pack list`, shared with twodog.import's list-pack mode. -->
    <ItemGroup>
        <Compile Include="../twodog.import/GdpcPack.cs" Link="GdpcPack.cs"/>
        <Compile Include="../twodog.import/EmbeddedPack.cs" Link="EmbeddedPack.cs"/>
    </ItemGroup>

    <!-- The REPL pipe protocol behind `2dog repl`, shared with 2dog.repl; TWODOG_CLI gives it this tool's namespace. -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);TWODOG_CLI</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../twodog.repl/ReplProtocol.cs" Link="Repl/ReplProtocol.cs"/>
        <!-- The agent guide 2dog skill writes, the same text as the host's ':help agents'. -->
        <EmbeddedResource Include="../twodog.repl/Agents/repl-guide.md" LogicalName="twodog.repl-guide.md" Link="Repl/repl-guide.md"/>
    </ItemGroup>

    <!-- The versions the tool scaffolds with, baked in at build time; an empty one would only surface at runtime -->
    <Target Name="TwoDogRequireVersions" BeforeTargets="CoreCompile">
        <Error Condition="'$(TwoDogVersion)' == '' Or '$(NativesVersion)' == '' Or '$(GodotVersion)' == ''"
               Text="TwoDogVersion, NativesVersion and GodotVersion must be set (see the repo-root Directory.Build.props)"/>
    </Target>
    <ItemGroup>
        <AssemblyMetadata Include="TwoDogVersion" Value="$(TwoDogVersion)"/>
        <AssemblyMetadata Include="NativesVersion" Value="$(NativesVersion)"/>
        <AssemblyMetadata Include="GodotSdkVersion" Value="$(GodotVersion)"/>
        <AssemblyMetadata Include="AvaloniaVersion" Value="$(AvaloniaVersion)"/>
        <AssemblyMetadata Include="MauiVersion" Value="$(MauiVersion)"/>
        <AssemblyMetadata Include="WindowsAppSdkVersion" Value="$(WindowsAppSdkVersion)"/>
        <AssemblyMetadata Include="AspNetCoreVersion" Value="$(AspNetCoreVersion)"/>
        <AssemblyMetadata Include="QtBridgeVersion" Value="$(QtBridgeVersion)"/>
    </ItemGroup>

    <!-- Embed the template's host subtrees verbatim (tokens substituted at runtime). The sln is NOT embedded
         (dotnet-new #if blocks); `2dog add` shells out to `dotnet sln` instead. -->
    <PropertyGroup>
        <!-- Local builds leave artifacts in the template folders; VerifyEmbeddedTemplateTracked only guards pack. -->
        <_TwoDogCliTplExcludes>../templates/twodog/**/bin/**;../templates/twodog/**/obj/**;../templates/twodog/**/TestResults/**</_TwoDogCliTplExcludes>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.2dog/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.2dog/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.web/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.web/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.webxr/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.webxr/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.xunit/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.xunit/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.repl/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.repl/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.nunit/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.nunit/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.gdunit/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.gdunit/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.winforms/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.winforms/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.winui/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.winui/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.avalonia/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.avalonia/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.qt/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.qt/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.blazor/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.blazor/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.maui/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.maui/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.android/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.android/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.ios/**/*" Exclude="$(_TwoDogCliTplExcludes)" LogicalName="tpl/Company.Product1.ios/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../templates/twodog/Company.Product1.csproj" LogicalName="tpl/Company.Product1.csproj"/>
        <EmbeddedResource Include="../templates/twodog/Directory.Build.targets" LogicalName="tpl/Directory.Build.targets"/>
        <EmbeddedResource Include="../templates/twodog/Directory.Build.props" LogicalName="tpl/Directory.Build.props"/>
        <EmbeddedResource Include="../templates/twodog/export_presets.cfg" LogicalName="tpl/export_presets.cfg"/>
        <EmbeddedResource Include="../templates/twodog/global.json" LogicalName="tpl/global.json"/>
        <!-- Godot project files, for `2dog new` -->
        <EmbeddedResource Include="../templates/twodog/project.godot" LogicalName="tpl/project.godot"/>
        <EmbeddedResource Include="../templates/twodog/main.tscn" LogicalName="tpl/main.tscn"/>
        <EmbeddedResource Include="../templates/twodog/fps_counter.tscn" LogicalName="tpl/fps_counter.tscn"/>
        <EmbeddedResource Include="../templates/twodog/.editorconfig" LogicalName="tpl/.editorconfig"/>
        <EmbeddedResource Include="../templates/twodog/.gitignore" LogicalName="tpl/.gitignore"/>
        <EmbeddedResource Include="../templates/twodog/.vscode/*.json" LogicalName="tpl/.vscode/%(Filename)%(Extension)"/>
    </ItemGroup>

    <!-- Unit tests in twodog.tests exercise the internal conversion pipeline -->
    <ItemGroup>
        <InternalsVisibleTo Include="twodog.tests"/>
    </ItemGroup>

    <!-- Package icon and readme -->
    <ItemGroup>
        <None Include="../nuget/icon.png" Pack="true" PackagePath="icon.png" Visible="false"/>
        <None Include="README.md" Pack="true" PackagePath="README.md"/>
    </ItemGroup>

</Project>
