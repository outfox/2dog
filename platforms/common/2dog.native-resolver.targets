<Project>
    <!-- Shared desktop resolver: per TwoDogNativeResolver item, find the $(TwoDogVariant) native (NuGet variant
         package first, godot/bin second) and copy it as <LibPrefix>-<variant>.<Ext>. Same copy in every package. -->
    <PropertyGroup>
        <_TwoDogNativeResolverImported>true</_TwoDogNativeResolverImported>
    </PropertyGroup>

    <Target Name="TwoDogResolveNativeLibs">
        <PropertyGroup>
            <_TwoDogNativeVariant>$(TwoDogVariant)</_TwoDogNativeVariant>
            <_TwoDogNativeVariant Condition="'$(_TwoDogNativeVariant)' == '' And '$(Configuration)' == 'Debug'">debug</_TwoDogNativeVariant>
            <_TwoDogNativeVariant Condition="'$(_TwoDogNativeVariant)' == '' And '$(Configuration)' == 'Editor'">editor</_TwoDogNativeVariant>
            <_TwoDogNativeVariant Condition="'$(_TwoDogNativeVariant)' == ''">release</_TwoDogNativeVariant>
        </PropertyGroup>
        <ItemGroup>
            <_TwoDogNativeResolved Include="@(TwoDogNativeResolver)"/>
            <_TwoDogNativeResolved>
                <LocalFile Condition="'$(_TwoDogNativeVariant)' == 'release'">%(LocalRelease)</LocalFile>
                <LocalFile Condition="'$(_TwoDogNativeVariant)' == 'debug'">%(LocalDebug)</LocalFile>
                <LocalFile Condition="'$(_TwoDogNativeVariant)' == 'editor'">%(LocalEditor)</LocalFile>
                <OutName>%(LibPrefix)-$(_TwoDogNativeVariant).%(Ext)</OutName>
                <!-- Defined-but-empty: unqualified metadata reads below error on items lacking the metadata -->
                <Resolved></Resolved>
            </_TwoDogNativeResolved>
            <_TwoDogNativeResolved>
                <PkgPath>$(NuGetPackageRoot)/%(PackageId).$(_TwoDogNativeVariant)$(TwoDogPackageSuffix)/%(PackageVersion)/runtimes/%(Identity)/native/%(OutName)</PkgPath>
                <PkgNativeDir>$(NuGetPackageRoot)/%(PackageId).$(_TwoDogNativeVariant)$(TwoDogPackageSuffix)/%(PackageVersion)/runtimes/%(Identity)/native/</PkgNativeDir>
                <LocalPath>%(LocalBin)%(LocalFile)</LocalPath>
                <SidecarDir>%(LocalBin)webgpu/%(Identity)/</SidecarDir>
            </_TwoDogNativeResolved>
            <_TwoDogNativeResolved>
                <Resolved Condition="Exists('%(PkgPath)')">%(PkgPath)</Resolved>
                <SidecarDir Condition="Exists('%(PkgPath)')">%(PkgNativeDir)</SidecarDir>
            </_TwoDogNativeResolved>
            <_TwoDogNativeResolved>
                <Resolved Condition="'%(Resolved)' == '' And Exists('%(LocalPath)')">%(LocalPath)</Resolved>
            </_TwoDogNativeResolved>
        </ItemGroup>
    </Target>

    <Target Name="TwoDogCopyNativeLibs"
            AfterTargets="Build"
            DependsOnTargets="TwoDogResolveNativeLibs"
            Condition="'$(DesignTimeBuild)' != 'true' And '$(TargetPlatformIdentifier)' != 'android' And '$(TargetPlatformIdentifier)' != 'ios'">
        <ItemGroup>
            <_TwoDogNativeForBuild Include="@(_TwoDogNativeResolved)"
                                   Condition="$([MSBuild]::IsOSPlatform('%(_TwoDogNativeResolved.HostOs)'))"/>
        </ItemGroup>
        <Warning Condition="'@(_TwoDogNativeForBuild)' != '' And '%(_TwoDogNativeForBuild.Resolved)' == ''"
                 Text="2dog: could not locate %(_TwoDogNativeForBuild.OutName) for %(_TwoDogNativeForBuild.Identity). Searched NuGet: %(_TwoDogNativeForBuild.PkgPath) - local: %(_TwoDogNativeForBuild.LocalPath). The application will fail at runtime with DllNotFoundException."/>
        <Copy SourceFiles="%(_TwoDogNativeForBuild.Resolved)"
              DestinationFiles="$(OutputPath)%(_TwoDogNativeForBuild.OutName)"
              SkipUnchangedFiles="true"
              Condition="'%(_TwoDogNativeForBuild.Resolved)' != ''"/>
        <ItemGroup>
            <_TwoDogSidecarForBuild Include="%(_TwoDogNativeForBuild.SidecarDir)**/*"
                                    Exclude="%(_TwoDogNativeForBuild.Resolved)"
                                    Condition="'%(_TwoDogNativeForBuild.Resolved)' != ''"/>
        </ItemGroup>
        <Copy SourceFiles="@(_TwoDogSidecarForBuild)"
              DestinationFiles="@(_TwoDogSidecarForBuild->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Message Importance="normal"
                 Text="2dog: copied %(_TwoDogNativeForBuild.OutName) to $(OutputPath)"
                 Condition="'%(_TwoDogNativeForBuild.Resolved)' != ''"/>
    </Target>

    <!-- A RID-less publish targets the build host, so an empty RuntimeIdentifier counts when the host OS matches;
         otherwise the publish folder ships without the native (DllNotFoundException). -->
    <Target Name="TwoDogSelectPublishNativeLibs" DependsOnTargets="TwoDogResolveNativeLibs">
        <ItemGroup>
            <_TwoDogNativeForPublish Include="@(_TwoDogNativeResolved)"
                                     Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('%(_TwoDogNativeResolved.HostOs)'))) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('%(_TwoDogNativeResolved.RidPrefix)'))"/>
            <_TwoDogSidecarForPublish Include="%(_TwoDogNativeForPublish.SidecarDir)**/*"
                                      Exclude="%(_TwoDogNativeForPublish.Resolved)"
                                      Condition="'%(_TwoDogNativeForPublish.Resolved)' != ''"/>
        </ItemGroup>
    </Target>

    <!-- Single-file publishes hand the natives to the SDK as runtime pack natives: it copies them beside the executable,
         or embeds them with IncludeNativeLibrariesForSelfExtract. Their deps.json entries make the host add its
         extraction directory to NATIVE_DLL_SEARCH_DIRECTORIES, where twodog's loader finds libgodot. -->
    <Target Name="TwoDogBundleNativeLibs"
            AfterTargets="ResolveRuntimePackAssets"
            DependsOnTargets="TwoDogSelectPublishNativeLibs"
            Condition="'$(PublishSingleFile)' == 'true' And '$(PublishAot)' != 'true' And '$(DesignTimeBuild)' != 'true' And '$(TargetPlatformIdentifier)' != 'android' And '$(TargetPlatformIdentifier)' != 'ios'">
        <ItemGroup>
            <_TwoDogBundledNative Include="%(_TwoDogNativeForPublish.Resolved)"
                                  DestinationSubPath="%(_TwoDogNativeForPublish.OutName)"
                                  Condition="'%(_TwoDogNativeForPublish.Resolved)' != ''"/>
            <_TwoDogBundledNative Include="@(_TwoDogSidecarForPublish)"
                                  DestinationSubPath="%(RecursiveDir)%(Filename)%(Extension)"
                                  Condition="'%(Extension)' == '.dll' Or '%(Extension)' == '.so' Or '%(Extension)' == '.dylib'"/>
            <RuntimePackAsset Include="@(_TwoDogBundledNative)"
                              AssetType="native"
                              RuntimePackName="2dog.natives"
                              NuGetPackageId="2dog.natives"
                              NuGetPackageVersion="@(_TwoDogNativeForPublish->'%(PackageVersion)')"
                              RuntimeIdentifier="$(RuntimeIdentifier)"
                              RuntimePackAlwaysCopyLocal="true"/>
        </ItemGroup>
    </Target>

    <!-- License texts and other sidecar data stay beside the executable. -->
    <Target Name="TwoDogPublishSidecarData"
            AfterTargets="ComputeResolvedFilesToPublishList"
            DependsOnTargets="TwoDogBundleNativeLibs"
            Condition="'$(PublishSingleFile)' == 'true' And '$(PublishAot)' != 'true' And '$(DesignTimeBuild)' != 'true' And '$(TargetPlatformIdentifier)' != 'android' And '$(TargetPlatformIdentifier)' != 'ios'">
        <ItemGroup>
            <ResolvedFileToPublish Include="@(_TwoDogSidecarForPublish)"
                                   Exclude="@(_TwoDogBundledNative)"
                                   RelativePath="%(RecursiveDir)%(Filename)%(Extension)"
                                   CopyToPublishDirectory="PreserveNewest"/>
        </ItemGroup>
    </Target>

    <Target Name="TwoDogPublishNativeLibs"
            AfterTargets="Publish"
            DependsOnTargets="TwoDogSelectPublishNativeLibs"
            Condition="'$(DesignTimeBuild)' != 'true' And '$(TargetPlatformIdentifier)' != 'android' And '$(TargetPlatformIdentifier)' != 'ios' And ('$(PublishSingleFile)' != 'true' Or '$(PublishAot)' == 'true')">
        <Copy SourceFiles="%(_TwoDogNativeForPublish.Resolved)"
              DestinationFiles="$(PublishDir)%(_TwoDogNativeForPublish.OutName)"
              SkipUnchangedFiles="true"
              Condition="'%(_TwoDogNativeForPublish.Resolved)' != ''"/>
        <Copy SourceFiles="@(_TwoDogSidecarForPublish)"
              DestinationFiles="@(_TwoDogSidecarForPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Message Importance="high"
                 Text="2dog: published %(_TwoDogNativeForPublish.OutName) to $(PublishDir)"
                 Condition="'%(_TwoDogNativeForPublish.Resolved)' != ''"/>
    </Target>
</Project>
