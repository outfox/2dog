<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
    <metadata>
        <id>2dog.linux-x64$precision$</id>
        <version>$version$</version>
        <authors>$authors$</authors>
        <license type="expression">MIT</license>
        <icon>icon.png</icon>
        <readme>README.md</readme>
        <projectUrl>https://github.com/outfox/2dog</projectUrl>
        <description>$description$</description>
        <dependencies>
            <group targetFramework=".NETStandard2.0">
                <!-- exclude="native": otherwise all three variants flow into every consumer output dir; the meta
                     targets copy the $(TwoDogVariant) one from the package cache instead. -->
                <dependency id="2dog.linux-x64.release$precision$" version="[$version$]" exclude="native"/>
                <dependency id="2dog.linux-x64.debug$precision$" version="[$version$]" exclude="native"/>
                <dependency id="2dog.linux-x64.editor$precision$" version="[$version$]" exclude="native"/>
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="../../nuget/icon.png" target="icon.png"/>
        <file src="README.md" target="README.md"/>
        <file src="../../nuget/GODOT_LICENSE.txt" target="LICENSE.txt"/>
        <file src="../../nuget/GODOT_AUTHORS.md" target="AUTHORS.md"/>
        <!-- MSBuild targets for native library copying -->
        <file src="$assetDir$/build/2dog.linux-x64$precision$.targets" target="build/2dog.linux-x64$precision$.targets"/>
        <file src="$assetDir$/build/2dog.native-resolver.targets" target="build/2dog.native-resolver.targets"/>
        <file src="$assetDir$/buildTransitive/2dog.linux-x64$precision$.targets" target="buildTransitive/2dog.linux-x64$precision$.targets"/>
        <file src="$assetDir$/build/2dog.precision.props" target="build/"/>
        <file src="$assetDir$/buildTransitive/2dog.precision.props" target="buildTransitive/"/>
        <file src="$assetDir$/build/2dog.linux-x64$precision$.props" target="build/"/>
        <file src="$assetDir$/buildTransitive/2dog.linux-x64$precision$.props" target="buildTransitive/"/>
    </files>
</package>
