<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsTestProject>false</IsTestProject>
        <!-- The collection definitions ship as compile-in source (build/2dog.xunit.targets); keep them out of
             2dog.xunit.dll or consumers would get duplicate types. -->
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>

    <!-- NuGet Package Metadata -->
    <PropertyGroup>
        <PackageId>2dog.xunit</PackageId>
        <Version>$(TwoDogVersion)</Version>
        <Description>xUnit collection definitions for testing Godot applications with 2dog. The collections are compiled into your test assembly so xUnit discovers them correctly; the fixtures they bind come from the 2dog.engine package.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsPackable>true</IsPackable>
        <!-- Build-only package: no meaningful assembly, so omit build output and silence NU5128 (deps, no lib/). -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <!-- 2dog.engine provides the fixtures; xunit.v3.extensibility.core (not the metapackage, which requires
         OutputType=Exe) provides ICollectionFixture<>/CollectionDefinition for the compiled-in source. -->
    <ItemGroup>
        <ProjectReference Include="..\twodog.engine\twodog.engine.csproj"/>
        <PackageReference Include="xunit.v3.extensibility.core" Version="3.*"/>
    </ItemGroup>

    <!-- Compile-in source plus the targets that injects it, all under build/ so $(MSBuildThisFileDirectory) works. -->
    <ItemGroup>
        <None Include="build\GodotCollection.cs"         Pack="true" PackagePath="build\"/>
        <None Include="build\GodotHeadlessCollection.cs" Pack="true" PackagePath="build\"/>
        <None Include="build\RenderingCollection.cs"     Pack="true" PackagePath="build\"/>
        <None Include="build\HeadlessCollection.cs"      Pack="true" PackagePath="build\"/>
        <None Include="build\2dog.xunit.targets"         Pack="true" PackagePath="build\"/>
    </ItemGroup>

    <!-- Package icon and readme -->
    <ItemGroup>
        <None Include="../nuget/icon.png" Pack="true" PackagePath="icon.png" Visible="false"/>
        <None Include="README.md" Pack="true" PackagePath="README.md"/>
    </ItemGroup>

</Project>
