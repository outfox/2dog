<Project>
    <!-- Keep the repo root Directory.Build.props in effect (this file would
         otherwise shadow it). Mirrors the web host template. -->
    <PropertyGroup>
        <_TwoDogParentProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_TwoDogParentProps>
    </PropertyGroup>
    <Import Project="$(_TwoDogParentProps)" Condition="'$(_TwoDogParentProps)' != ''"/>
    <!-- Browser bundles are only useful optimized: default to Release (pass -c Debug to override). Must be set
         this early - the SDK derives DEBUG/Optimize from Configuration before the csproj body is read -->
    <PropertyGroup>
        <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    </PropertyGroup>
</Project>
