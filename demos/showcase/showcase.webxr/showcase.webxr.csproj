<Project Sdk="Microsoft.NET.Sdk">
    <!-- showcase.web plus the WebXR Layers polyfill. Publish from the repo root (global.json pins the SDK band):
         dotnet publish demos/showcase/showcase.webxr -> AppBundle/, serve over localhost or HTTPS -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Marks this host as the WebXR flavor for the 2dog tool's host scan. -->
        <TwoDogWebXR>true</TwoDogWebXR>
    </PropertyGroup>
    <!-- Godot project location: the parent directory (hosts are nested inside
         the Godot project, hidden from the Godot editor by their .gdignore) -->
    <PropertyGroup>
        <GodotProjectDir>..</GodotProjectDir>
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
    </PropertyGroup>

    <ItemGroup>
        <!-- TwoDogWebBoot.cs is compiled by the GAME project (see the root
             csproj's Compile Include), not by this host. -->
        <Compile Remove="TwoDogWebBoot.cs"/>
    </ItemGroup>

    <!-- Engine from the source checkout by default; -p:Official=true consumes the published NuGet packages.
         The game project stays a ProjectReference either way -->
    <ItemGroup>
        <ProjectReference Include="../../../twodog.engine/twodog.engine.csproj" Condition="'$(Official)' != 'true'"/>
        <ProjectReference Include="../showcase.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(Official)' == 'true'">
        <PackageReference Include="2dog.engine" Version="$(TwoDogVersion)"/>
        <PackageReference Include="2dog.browser-wasm" Version="[$(NativesVersion)]"/>
    </ItemGroup>

    <!-- Root the game assembly: scripts are resolved by reflection.
         (GodotSharp and twodog are rooted by the browser-wasm targets.) -->
    <ItemGroup>
        <TrimmerRootAssembly Include="showcase"/>
        <TrimmerRootAssembly Include="$(TargetName)"/>
    </ItemGroup>

    <!-- Source-checkout stand-ins for the package targets: 2dog.engine, the host-OS desktop meta targets (editor
         libgodot for the .pck export) and browser-wasm (all web wiring); Official=true gets these transitively -->
    <Import Project="../../../twodog.engine/build/2dog.engine.targets" Condition="'$(Official)' != 'true'"/>
    <Import Project="../../../platforms/twodog.win-x64/build/2dog.win-x64.targets" Condition="'$(Official)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))"/>
    <Import Project="../../../platforms/twodog.linux-x64/build/2dog.linux-x64.targets" Condition="'$(Official)' != 'true' And $([MSBuild]::IsOSPlatform('Linux'))"/>
    <Import Project="../../../platforms/twodog.osx-arm64/build/2dog.osx-arm64.targets" Condition="'$(Official)' != 'true' And $([MSBuild]::IsOSPlatform('OSX'))"/>
    <Import Project="../../../platforms/twodog.browser-wasm/build/2dog.browser-wasm.targets" Condition="'$(Official)' != 'true'"/>

    <Target Name="DeepClean" AfterTargets="Clean">
        <RemoveDir Directories="AppBundle"/>
    </Target>
</Project>
