<Project Sdk="Godot.NET.Sdk/4.7.2">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTrimmable>true</IsTrimmable>
        <IsPackable>false</IsPackable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <!-- Compile the repository demo against the fork, including its trim annotations.
             A host's 2dog.engine dependency does not flow back into this game project. -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <!-- 2dog.godotsharp generates TwoDogWebBoot (the web hosts' plugins initializer) only with unsafe code -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Keep nested host projects out of the default compile/content globs (their .gdignore hides them
             from the Godot editor) -->
        <DefaultItemExcludes>$(DefaultItemExcludes);showcase.2dog/**;showcase.double/**;showcase.repl/**;showcase.web/**;showcase.webmt/**;showcase.webxr/**;showcase.blazor/**;showcase.winforms/**;showcase.winui/**;showcase.avalonia/**;showcase.android/**;showcase.maui/**;showcase.ios/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="2dog.godotsharp$(TwoDogPackageSuffix)" Version="$(TwoDogVersion)" />
        <PackageReference Include="2dog.godotsharp.editor$(TwoDogPackageSuffix)" Version="$(TwoDogVersion)"
                          Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Editor'" />
    </ItemGroup>
    <!-- The GDExtension probe's native library for this machine's desktop platform (hosts build this project first) -->
    <Import Project="gdextension/TwoDogProbe.targets"/>
</Project>
