<Project Sdk="Godot.NET.Sdk/4.7.2">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTrimmable>true</IsTrimmable>
        <IsPackable>false</IsPackable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <!-- Compile the repository demo against the fork, including its trim annotations.
             A host's 2dog.engine dependency does not flow back into this game project. -->
        <DisableImplicitGodotSharpReferences>true</DisableImplicitGodotSharpReferences>
        <DisableImplicitGodotGeneratorReferences>true</DisableImplicitGodotGeneratorReferences>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <!-- TwoDogWebBoot.cs (web hosts) takes a function pointer to the source-generated plugins initializer;
             harmless on desktop -->
        <DefineConstants>$(DefineConstants);TWODOG_WEB_BOOT</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Keep nested host projects out of the default compile/content globs (their .gdignore hides them
             from the Godot editor) -->
        <DefaultItemExcludes>$(DefaultItemExcludes);showcase.2dog/**;showcase.web/**;showcase.webxr/**;showcase.blazor/**;showcase.winforms/**;showcase.winui/**;showcase.avalonia/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="2dog.godotsharp" Version="$(TwoDogVersion)" />
        <PackageReference Include="2dog.godotsharp.editor" Version="$(TwoDogVersion)"
                          Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Editor'" />
    </ItemGroup>
    <ItemGroup>
        <!-- Web bootstrap lives in the web host folder but must compile into THIS assembly: scripts resolve
             from the assembly holding the source-generated plugins initializer -->
        <Compile Include="showcase.web/TwoDogWebBoot.cs"
                 Condition="Exists('$(MSBuildThisFileDirectory)showcase.web/TwoDogWebBoot.cs')"/>
        <!-- The webxr host carries its own copy; compile it only when the web host's is absent (one definition
             per assembly) -->
        <Compile Include="showcase.webxr/TwoDogWebBoot.cs"
                 Condition="!Exists('$(MSBuildThisFileDirectory)showcase.web/TwoDogWebBoot.cs') And Exists('$(MSBuildThisFileDirectory)showcase.webxr/TwoDogWebBoot.cs')"/>
        <!-- Same for the blazor host, last in line -->
        <Compile Include="showcase.blazor/TwoDogWebBoot.cs"
                 Condition="!Exists('$(MSBuildThisFileDirectory)showcase.web/TwoDogWebBoot.cs') And !Exists('$(MSBuildThisFileDirectory)showcase.webxr/TwoDogWebBoot.cs') And Exists('$(MSBuildThisFileDirectory)showcase.blazor/TwoDogWebBoot.cs')"/>
    </ItemGroup>
</Project>
