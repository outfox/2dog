@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>2dog showcase — Blazor host</PageTitle>

<div class="layout">
    <aside class="panel">
        <header class="panel-header">
            <div>
                <h1>2dog showcase</h1>
                <p class="subtitle">Blazor UI beside Godot</p>
            </div>
            <p class="status" data-state="@_state">@_status</p>
        </header>

        <dl>
            <dt>Godot</dt>
            <dd>@_godotVersion</dd>
            <dt>2dog</dt>
            <dd>@_twodogVersion</dd>
            <dt>Scene</dt>
            <dd>@_sceneName</dd>
            <dt>FPS</dt>
            <dd>@_fps</dd>
            <dt>Frames</dt>
            <dd>@_frames</dd>
        </dl>

        <label class="field">
            <span class="field-label">White cube spin <output>@_spinSpeed.ToString("0.0") rad/s</output></span>
            <input type="range" min="0" max="10" step="0.1" value="@_spinSpeed"
                   @oninput="OnSpinSpeed" disabled="@(!IsRunning)"/>
            <span class="hint">The white cubes are driven by this page.</span>
        </label>

        <button class="primary" @onclick="TogglePause" disabled="@(!IsRunning)">@(_paused ? "Resume" : "Pause")</button>

        <div class="actions">
            <button @onclick="() => _view!.StartAsync()" disabled="@(_view is null || IsRunning)">Start engine</button>
            <button @onclick="() => _view?.Quit()" disabled="@(!IsRunning)">Quit engine</button>
            <button @onclick="RestartEngine" disabled="@(!IsRunning)">Restart engine</button>
        </div>
    </aside>

    <main class="viewport">
        <GodotView @ref="_view" Project="showcase" PluginsInitializer="TwoDogWebBoot.PluginsInitializer()"
                   OnFrame="OnFrame" Started="OnStarted" Exited="OnExited" Failed="OnFailed"
                   style="width: 100%; height: 100%;">
            <div class="hud">@_fps fps</div>
        </GodotView>
    </main>
</div>
