<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- WinExe hides the console on Windows (plain Exe elsewhere); switch to Exe
             to see the engine's stdout diagnostics. -->
        <OutputType>WinExe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- The assembly keeps the folder name, but 'showcase.avalonia' is not a
             valid C# namespace for types shared with the other hosts. -->
        <RootNamespace>showcase</RootNamespace>
        <!-- comctl32 v6 + long paths for Godot's Windows display server -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>
    <!-- Godot project location: the parent directory (the Godot project is
         the solution root; hosts are nested inside it, hidden from the Godot
         editor by their .gdignore) -->
    <PropertyGroup>
        <GodotProjectDir>..</GodotProjectDir>
    </PropertyGroup>

    <!-- In this repo the native variant follows the build configuration
         (consumers set TwoDogVariant explicitly; default is release) -->
    <PropertyGroup>
        <TwoDogVariant Condition="'$(Configuration)' == 'Debug'">debug</TwoDogVariant>
        <TwoDogVariant Condition="'$(Configuration)' == 'Editor'">editor</TwoDogVariant>
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="2dog.avalonia" Version="$(TwoDogVersion)"/>
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/>
        <!-- Native Wayland backend (experimental, not part of UsePlatformDetect);
             enabled via UseWaylandWithFallback so X11 remains the fallback. -->
        <PackageReference Include="Avalonia.Wayland" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)"/>
        <!-- No Avalonia.Diagnostics: the F12 DevTools left the open-source package line after 11.x. -->

    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../showcase.csproj"/>
    </ItemGroup>
</Project>
